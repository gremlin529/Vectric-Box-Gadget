-- Enums and constants
FaceJointType = {
  Inset = 1,
  Fingers = 2,
  Flat  = 3,
  None = 4
}

FaceType = {
  Bottom = 1,
  Lid = 2,
  Side = 3,
  End = 4
}

local unit_x = Vector2D(1,0)
local unit_y = Vector2D(0,1)

-- ---------- VALIDATION HELPERS ----------

function ThicknessForFaceType(faceType, thickness)
  if (faceType == FaceJointType.None) then -- No lid or bottom, inner height isn't reduced
    return 0
  elseif (faceType == FaceJointType.Inset) then -- if Inset than the inner height is reduced by half the thickness of the material
    return 0.5 * thickness
  end
  -- if Flat or Fingers than the inner height is reduced by the thickness of the material
  return thickness
end

function FaceJointTypeToString( joint )
  for k, v in pairs(FaceJointType) do
    if (v == joint) then
      return k
    end
  end
  return ""
end

function Face(outer_contour, inset_contours, dovetails, tabs, name, facetype, jointtype, flute_sockets, fingerSides)
  local obj ={}
  obj.name = name
  obj.tabs = tabs
  obj.facetype = facetype
  obj.jointtype = jointtype
  obj.contour = outer_contour
  obj.inset_contours = inset_contours -- used for an inset lid or bottom the contour for the rabbet
  obj.dovetail_list = dovetails
  obj.flute_sockets = flute_sockets or {}
  obj.fingerSides = fingerSides or nil
  return obj
end

-- Apply only the linear (rotation/scale) part of a transform to a direction
-- vector, so a pure translation leaves it unchanged.
function TransformVector2D(xform, v)
  local origin = xform * Point2D(0.0, 0.0)
  local tip    = xform * Point2D(v.x, v.y)
  return Vector2D(tip.x - origin.x, tip.y - origin.y)
end

function TransformFace(face, xform)
  face.contour:Transform(xform)

  -- inset contours for rabbet lid or bottom
  if (face.inset_contours ~= nil) then
    face.inset_contours:Transform(xform)
  end

  -- Transform dovetail markers
  local dovetails = face.dovetail_list
  for i=1,#dovetails do
    local marker = dovetails[i]
    marker:Transform(xform)
  end

  -- Transform the tabs
  local tabs = face.tabs
  for i=1,#tabs do
    face.tabs[i] =  xform * face.tabs[i]
  end

  -- Transform the finger sides
  if (face.fingerSides ~= nil)then
    face.fingerSides:Transform(xform)
  end

  -- Transform the flute sockets. The socket owns its points and vectors
  -- (see AddFemaleDoveTailsAlongLine) so they must be moved explicitly.
  -- The direction vectors only take the rotation part of the transform.
  if face.flute_sockets then
    for i = 1, #face.flute_sockets do
      local socket = face.flute_sockets[i]

      socket.start_pt = xform * socket.start_pt
      socket.end_pt   = xform * socket.end_pt

      socket.along = TransformVector2D(xform, socket.along)
      socket.out   = TransformVector2D(xform, socket.out)
      socket.along:Normalize()
      socket.out:Normalize()
    end
  end
end

function GetAllProfileContours(faces)
  local contour_group = ContourGroup(true)
  for i=1,#faces do
    contour_group:AddTail(faces[i].contour:Clone())
  end
  return contour_group
end

function GetAllProfileCadContours(faces)
  local cad_object_list = CadObjectList(true)
  for i=1,#faces do
    local cur_face = faces[i]
    local cad_contour = MakeCadAndAddTabs(cur_face.contour, cur_face.tabs)
    cad_object_list:AddTail(cad_contour)
  end
  return cad_object_list
end

-- we actually want to group each side and return a list of groups
-- that somehow we then want to add.
-- each fingerSides on a face is a ContourGroup
function GetAllFingerSides(faces)
  local fingerSideArray = {}
  for i=1,#faces do
    if (faces[i].fingerSides ~= nil) then
      fingerSideArray[#fingerSideArray + 1] = faces[i].fingerSides:Clone()
    end
  end
  return fingerSideArray
end

function CreateInsetPocketToolpath(job, options, faces, tool, layer_name)

  if not Tool_ok(tool) then
    DisplayMessageBox("Pocket Toolpath: Please select a valid tool before continuing.")
    return false
  end

  -- first we must create cad contours from any face which has a lid and select all on that layer
  local cad_object_list = CadObjectList(true)
  for i=1,#faces do
    local cur_face = faces[i]
    if (cur_face.jointtype == FaceJointType.Inset) then
      local pos = cur_face.inset_contours:GetHeadPosition()
      while pos ~= nil do
        local contour
        contour, pos = cur_face.inset_contours:GetNext(pos)
        local cad_contour = CreateCadContour(contour)
        cad_object_list:AddTail(cad_contour)
      end

    end
  end

  local pocket_objects = AddCadListToJob(job, cad_object_list, layer_name)
  SelectExactObjects(job, pocket_objects)

  local pos_data = ToolpathPosData()
  local pocket_data = PocketParameterData()
  pocket_data.start_depth = 0
  pocket_data.CutDepth = 0.5*options.thickness
  pocket_data.Allowance = -options.allowance
  pocket_data.DoRaster = false
  pocket_data.DoRamping = true
  pocket_data.RampDistance = 0.3*options.height

  local geometry_selector = GeometrySelector()

  local area_clear_tool = nil

  local toolpath_manager = ToolpathManager()
  toolpath_manager:CreatePocketingToolpath(
    "Pocket",
    tool,
    area_clear_tool,
    pocket_data,
    pos_data,
    geometry_selector,
    true,
    true)
end

--[[  -------------- MakeBottomFace --------------------------------------------------
|
|  Make the bottom face of the box
|  Returns the contour for the profile and a list of dovetails
|
]]
  function MakeBottomFaceContour(width, height, thickness, start_point, dovetail,
      use_dovetails, bottomType, facesToMake, create_tabs_for_missing_faces, name)

    local dovetail_markers = {}
    local flute_sockets = {}
    local tablist = {}
    local outer_blc = start_point
    local outer_brc = start_point  + width*Vector2D(1,0)
    local outer_trc = outer_brc + height*Vector2D(0,1)
    local outer_tlc = start_point + height*Vector2D(0, 1)
    local fingerSides = ContourGroup(true) -- this will hold the sides of the fingers for the roundover layer if dogbones aren't made

    -- // Width and height of interior rectangle
    local inner_width = width - 2*thickness
    local inner_height = height - 2*thickness

    -- Calculate number of flaps needed. In this case
    -- then each "flap" represents a piece of the outer
    -- contour then goes inwards
    local num_flaps_w = math.floor((0.5*inner_width) / dovetail.min_width )
    local num_flaps_h = math.floor((0.5*inner_height) / dovetail.min_width)

    local tab_space_w = (inner_width - num_flaps_w*dovetail.min_width)/ (num_flaps_w + 1)
    local tab_space_h = (inner_height - num_flaps_h*dovetail.min_width)/ (num_flaps_h + 1)

    -- Create the contour
    local contour = Contour(0.0)
    contour:AppendPoint(start_point)

    -- Create blc -> brc
    -- Create the internal flaps.


    -- line to first blc -> brc (Side 1)
    if ((create_tabs_for_missing_faces or facesToMake.side1) and bottomType == FaceJointType.Fingers) then
      LineToVector(contour, (thickness + tab_space_w)*unit_x)
      AddMiddleOfLastSpanToList(contour, tablist)
      AddFemaleDoveTailsAlongLine(thickness, dovetail, unit_x, unit_y, contour, num_flaps_w,
                                   tab_space_w, dovetail_markers, flute_sockets, fingerSides)
      contour:LineTo(outer_brc)
      AddMiddleOfLastSpanToList(contour, tablist)
    else
      LineToVector(contour, (thickness + tab_space_w)*unit_x)
      AddMiddleOfLastSpanToList(contour, tablist)
      contour:LineTo(outer_brc)
      AddMiddleOfLastSpanToList(contour, tablist)
    end

    -- Create brc -> trc (end 1)
    if ((create_tabs_for_missing_faces or facesToMake.end1) and bottomType == FaceJointType.Fingers) then
      LineToVector(contour, (thickness + tab_space_h)*unit_y)
      AddMiddleOfLastSpanToList(contour, tablist)
      AddFemaleDoveTailsAlongLine(thickness, dovetail, unit_y, -unit_x, contour, num_flaps_h,
                                    tab_space_h, dovetail_markers, flute_sockets, fingerSides)
      contour:LineTo(outer_trc)
      AddMiddleOfLastSpanToList(contour, tablist)
    else
      LineToVector(contour, (thickness + tab_space_h)*unit_y)
      AddMiddleOfLastSpanToList(contour, tablist)
      contour:LineTo(outer_trc)
      AddMiddleOfLastSpanToList(contour, tablist)
    end

    -- Create trc -> tlc (side 2)
    if ((create_tabs_for_missing_faces or facesToMake.side2) and bottomType == FaceJointType.Fingers) then
      LineToVector(contour, (thickness + tab_space_w)*(-unit_x))
      AddMiddleOfLastSpanToList(contour, tablist)
      AddFemaleDoveTailsAlongLine(thickness, dovetail, -unit_x, -unit_y, contour, num_flaps_w,
                                    tab_space_w, dovetail_markers, flute_sockets, fingerSides)
      contour:LineTo(outer_tlc)
      AddMiddleOfLastSpanToList(contour, tablist)
    else
      LineToVector(contour, (thickness + tab_space_w)*(-unit_x))
      AddMiddleOfLastSpanToList(contour, tablist)
      contour:LineTo(outer_tlc)
      AddMiddleOfLastSpanToList(contour, tablist)
    end

    -- Create tlc -> blc (end 2)
    if ((create_tabs_for_missing_faces or facesToMake.end2) and bottomType == FaceJointType.Fingers) then
      LineToVector(contour, (thickness + tab_space_h)*(-unit_y))
      AddMiddleOfLastSpanToList(contour, tablist)
      AddFemaleDoveTailsAlongLine(thickness, dovetail, -unit_y, unit_x, contour, num_flaps_h,
                                    tab_space_h, dovetail_markers, flute_sockets, fingerSides)
      contour:LineTo(outer_blc)
      AddMiddleOfLastSpanToList(contour, tablist)
    else
      LineToVector(contour, (thickness + tab_space_h)*(-unit_y))
      AddMiddleOfLastSpanToList(contour, tablist)
      contour:LineTo(outer_blc)
      AddMiddleOfLastSpanToList(contour, tablist)
    end

    -- This is the contour that will be used to cut the pocket for inset joint
    local inset_contours = MakeInsetContours(width, height, thickness, start_point, facesToMake,
      create_tabs_for_missing_faces, name, FaceType.Bottom,
      inner_width, inner_height)

    return Face(contour, inset_contours, dovetail_markers, tablist, name, FaceType.Bottom, bottomType, flute_sockets, fingerSides)
  end

-- Make the side faces
-- Gremlin added bottom and top dovetails separate from side
  function MakeSideFace(width, height, thickness, start_point, sidedovetail, bottomdovetail, topdovetail, dovetailJoint,
      lidType, bottomType, facesToMake, create_tabs_for_missing_faces, is_side1, name)

    local dovetail_markers = {}
    local tablist = {}
    local fingerSides = ContourGroup(true) -- this will hold the sides of the fingers for the roundover layer if dogbones aren't made

    -- When creating side 1 the left face is end 1, when creating side 2 its end 2
    -- this is so that we can build the box with entirely one side of the wood up if desired
    -- end2 is the right side for side1 and left for side 2
    local makeTabsForLeftFace = create_tabs_for_missing_faces or (facesToMake.end1 and is_side1) or (facesToMake.end2 and not is_side1)
    local makeTabsForRightFace = create_tabs_for_missing_faces or (facesToMake.end2 and is_side1) or (facesToMake.end1 and not is_side1)

    -- Only inset by thickness on an end when that end is either getting tabs cut into it
    -- or the adjoining end face actually exists to fill the gap. If the end face is missing
    -- and no tabs are being made there, nothing fills that thickness-wide strip, so the side
    -- needs to extend all the way out to the full width on that end instead of being inset.
    local left_inset = makeTabsForLeftFace and thickness or 0
    local right_inset = makeTabsForRightFace and thickness or 0

    local inner_start_point = start_point + Vector2D(left_inset, thickness)
    local inner_width  = width - left_inset - right_inset

    -- inner height is the inside height of the box,
    -- or the distance before the fingers

    local bottom_thickness = thickness
    if (bottomType == FaceJointType.None) then
      bottom_thickness = 0
    elseif (bottomType == FaceJointType.Inset) then
      bottom_thickness = 0.5*thickness
    elseif (bottomType == FaceJointType.Flat) then
      bottom_thickness = thickness
    else
      bottom_thickness = thickness
    end

    local top_thickness = thickness
    if (lidType == FaceJointType.None) then
      top_thickness = 0
    elseif (lidType == FaceJointType.Inset) then
      top_thickness = 0.5*thickness
    elseif (lidType == FaceJointType.Flat) then
      top_thickness = thickness
    else
      top_thickness = thickness
    end

    local inner_height = height - (bottom_thickness + top_thickness)

    local inner_blc = inner_start_point
    local inner_brc = inner_start_point + inner_width * unit_x
    local inner_trc = inner_brc + inner_height*unit_y
    local inner_tlc = inner_blc + inner_height*unit_y

    -- Gremlin added bottom and top dovetails separate from side
    local num_flaps_bottom = math.floor((0.5*inner_width) / bottomdovetail.min_width )
    local num_flaps_top = math.floor((0.5*inner_width) / topdovetail.min_width )
    local num_flaps_side = math.floor((0.5*inner_height) / sidedovetail.min_width)

    local tab_space_bottom = (inner_width - num_flaps_bottom*bottomdovetail.min_width)/ (num_flaps_bottom + 1)
    local tab_space_top = (inner_width - num_flaps_top*topdovetail.min_width)/ (num_flaps_top + 1)
    local tab_space_side = (inner_height - num_flaps_side*sidedovetail.min_width)/ (num_flaps_side + 1)

    -- Create the contour
    local contour = Contour(0.0)
    contour:AppendPoint(inner_start_point)

    -- blc -> brc is the bottom edge of the side face
    if ((bottomType ~= FaceJointType.Fingers) or
      (facesToMake.bottom == false and not create_tabs_for_missing_faces and bottomType==FaceJointType.Fingers)) then
      -- in this case the bottom edge has no tabs, and starts at 0,0
      LineToVector(contour, -0.0*unit_y)
      LineToVector(contour, inner_width*unit_x)
      AddMiddleOfLastSpanToList(contour, tablist)
      contour:LineTo(inner_brc)
    else
      -- in this case the bottom edge has tabs and starts at thickness, thickness
      LineToVector(contour, tab_space_bottom*unit_x)
      AddMiddleOfLastSpanToList(contour, tablist)
      if (dovetailJoint) then
        AddMaleDoveTailsAlongLine(thickness, bottomdovetail, unit_x, -unit_y, contour,  num_flaps_bottom, tab_space_bottom)
      else
        AddFlapsAlongLine(thickness, bottomdovetail.min_width, tab_space_bottom, unit_x, -unit_y, contour, num_flaps_bottom, fingerSides)
      end
      contour:LineTo(inner_brc)
      AddMiddleOfLastSpanToList(contour, tablist)
    end

    -- -- brc -> trc (tabs for right end)
    if (makeTabsForRightFace) then
      LineToVector(contour, tab_space_side*unit_y)
      AddMiddleOfLastSpanToList(contour, tablist)
      if dovetailJoint then
        AddMaleDoveTailsAlongLine(thickness, sidedovetail, unit_y, unit_x, contour, num_flaps_side, tab_space_side)
      else
        AddFlapsAlongLine(thickness, sidedovetail.min_width, tab_space_side, unit_y, unit_x, contour, num_flaps_side, fingerSides)
      end
      contour:LineTo(inner_trc)
      AddMiddleOfLastSpanToList(contour, tablist)
    else
      LineToVector(contour, tab_space_side*unit_y)
      AddMiddleOfLastSpanToList(contour, tablist)
      contour:LineTo(inner_trc)
      AddMiddleOfLastSpanToList(contour, tablist)
    end

    -- trc -> tlc (top line so has flaps for lid)
    if ((lidType ~= FaceJointType.Fingers) or
      (facesToMake.lid == false and not create_tabs_for_missing_faces and lidType==FaceJointType.Fingers)) then
      -- this is for no lid
      -- so the box goes the whole-way up
      -- Also used for a dovetail/tabbed lid where we're not cutting tabs as it would also
      -- be full height
      LineToVector(contour, 0*unit_y)
      LineToVector(contour, -inner_width*unit_x)
      AddMiddleOfLastSpanToList(contour, tablist)
      contour:LineTo(inner_tlc)
    else
      -- this is for a tabbed/dovetailed lid
      LineToVector(contour, -tab_space_top*unit_x)
      AddMiddleOfLastSpanToList(contour, tablist)
      if (dovetailJoint) then
        AddMaleDoveTailsAlongLine(thickness, topdovetail, -unit_x, unit_y, contour, num_flaps_top, tab_space_top)
      else
        AddFlapsAlongLine(thickness, topdovetail.min_width, tab_space_top, -unit_x, unit_y, contour, num_flaps_top, fingerSides)
      end
      contour:LineTo(inner_tlc)
      AddMiddleOfLastSpanToList(contour, tablist)
    end

    -- tlc -> blc this is the left end
    if (makeTabsForLeftFace) then
      LineToVector(contour, -tab_space_side*unit_y)
      AddMiddleOfLastSpanToList(contour, tablist)
      if (dovetailJoint) then
        AddMaleDoveTailsAlongLine(thickness, sidedovetail, -unit_y, -unit_x, contour, num_flaps_side, tab_space_side)
      else
        AddFlapsAlongLine(thickness, sidedovetail.min_width, tab_space_side, -unit_y, -unit_x, contour, num_flaps_side, fingerSides)
      end
      contour:LineTo(inner_blc)
      AddMiddleOfLastSpanToList(contour, tablist)
    else
      LineToVector(contour, -tab_space_side*unit_y)
      AddMiddleOfLastSpanToList(contour, tablist)
      contour:LineTo(inner_blc)
      AddMiddleOfLastSpanToList(contour, tablist)
    end

    return Face(contour, nil, dovetail_markers, tablist, name, FaceType.Side, FaceJointType.Fingers, nil, fingerSides)
  end

-- Make an end face
-- Gremlin added doevtail seperation for different sizes
  function MakeEndFace(width, height, thickness, start_point, sidedovetail, bottomdovetail, topdovetail, dovetailJoint,
      lidType, bottomType, facesToMake, create_tabs_for_missing_faces, is_end1, name)

    local tablist = {}
    local dovetail_markers = {}
    local flute_sockets = {}
    local fingerSides = ContourGroup(true) -- this will hold the sides of the fingers for the roundover layer if dogbones aren't made

    local bottom_thickness = 0
    if (bottomType == FaceJointType.None) then
      bottom_thickness = 0
    elseif (bottomType == FaceJointType.Inset) then
      bottom_thickness = 0.5*thickness
    elseif (bottomType == FaceJointType.Flat) then
      bottom_thickness = thickness
    else
      bottom_thickness = thickness
    end

    local top_thickness = 0
    if (lidType == FaceJointType.None) then
      top_thickness = 0
    elseif (lidType == FaceJointType.Inset) then
      top_thickness = 0.5*thickness
    elseif (lidType == FaceJointType.Flat) then
      top_thickness = thickness
    else
      top_thickness = thickness
    end

    local inner_start_point = start_point + bottom_thickness * unit_y

    local inner_width = width - 2*thickness;
    local inner_height  = height - (top_thickness + bottom_thickness)

    local inner_blc = inner_start_point
    local inner_brc = inner_start_point + width * unit_x
    local inner_trc = inner_brc + inner_height*unit_y
    local inner_tlc = inner_blc + inner_height*unit_y

    -- Gremlin added doevtail seperation for different sizes
    local num_flaps_bottom = math.floor((0.5*inner_width)/ bottomdovetail.min_width)
    local num_flaps_top = math.floor((0.5*inner_width) / topdovetail.min_width)
    local num_flaps_side = math.floor((0.5*inner_height) / sidedovetail.min_width)

    local tab_space_bottom = (inner_width - num_flaps_bottom*bottomdovetail.min_width) / (num_flaps_bottom + 1)
    local tab_space_top = (inner_width - num_flaps_top*topdovetail.min_width) / (num_flaps_top + 1)
    local tab_space_side = (inner_height - num_flaps_side*sidedovetail.min_width) / (num_flaps_side + 1)

    local makeTabsForLeftEnd = create_tabs_for_missing_faces or (facesToMake.side1 and is_end1) or (facesToMake.side2 and not is_end1)
    local makeTabsForRightEnd = create_tabs_for_missing_faces or (facesToMake.side2 and is_end1) or (facesToMake.side1 and not is_end1)

    local contour = Contour(0.0)
    contour:AppendPoint(inner_start_point)

    -- blc --> brc (tabs for bottom)
    if ((bottomType ~= FaceJointType.Fingers) or
      (facesToMake.bottom == false and not create_tabs_for_missing_faces and bottomType==FaceJointType.Fingers)) then
      contour:LineTo(inner_brc)
    else
      LineToVector(contour, (tab_space_bottom + thickness)*unit_x)
      AddMiddleOfLastSpanToList(contour, tablist)
      if (dovetailJoint) then
        AddMaleDoveTailsAlongLine(thickness, bottomdovetail, unit_x, -unit_y, contour, num_flaps_bottom, tab_space_bottom)
      else
        AddFlapsAlongLine(thickness, bottomdovetail.min_width, tab_space_bottom, unit_x, -unit_y, contour, num_flaps_bottom, fingerSides)
      end
      contour:LineTo(inner_brc)
    end
    AddMiddleOfLastSpanToList(contour, tablist)

    -- brc --> trc (tabs for right side)
    if (makeTabsForRightEnd) then
      LineToVector(contour,  (tab_space_side)*unit_y)
      AddMiddleOfLastSpanToList(contour, tablist)
      AddFemaleDoveTailsAlongLine(thickness, sidedovetail, unit_y, -unit_x, contour, num_flaps_side, tab_space_side, dovetail_markers, flute_sockets, fingerSides)
      contour:LineTo(inner_trc)
      AddMiddleOfLastSpanToList(contour, tablist)
    else
      LineToVector(contour,  tab_space_side*unit_y)
      AddMiddleOfLastSpanToList(contour, tablist)
      contour:LineTo(inner_trc)
      AddMiddleOfLastSpanToList(contour, tablist)
    end

    -- if the lid is flat then we go up by half thickness and then across
    -- trc -> tlc (top edge)
    if ((lidType ~= FaceJointType.Fingers) or
      (facesToMake.lid == false and not create_tabs_for_missing_faces and lidType==FaceJointType.Fingers)) then
      contour:LineTo(inner_tlc)
      AddMiddleOfLastSpanToList(contour, tablist)
    else
      LineToVector(contour, (tab_space_top + thickness) * (-unit_x))
      AddMiddleOfLastSpanToList(contour, tablist)

      if dovetailJoint then
        AddMaleDoveTailsAlongLine(thickness,
          topdovetail,
          -unit_x,
          unit_y,
          contour,
          num_flaps_top,
          tab_space_top
        )
      else
        AddFlapsAlongLine(
          thickness,
          topdovetail.min_width,
          tab_space_top,
          -unit_x,
          unit_y,
          contour,
          num_flaps_top,
          fingerSides
        )
      end

      contour:LineTo(inner_tlc)
      AddMiddleOfLastSpanToList(contour, tablist)
    end

    -- tlc -> brc
    if (makeTabsForLeftEnd) then
      LineToVector(contour, (tab_space_side*-unit_y))
      AddMiddleOfLastSpanToList(contour, tablist)
      AddFemaleDoveTailsAlongLine(thickness, sidedovetail, -unit_y, unit_x, contour, num_flaps_side, tab_space_side, dovetail_markers, flute_sockets, fingerSides)
      AddMiddleOfLastSpanToList(contour, tablist)
    else
      LineToVector(contour, (tab_space_side*-unit_y))
      AddMiddleOfLastSpanToList(contour, tablist)
      contour:LineTo(inner_blc)
      AddMiddleOfLastSpanToList(contour, tablist)
    end

    return Face(contour, nil, dovetail_markers, tablist, name, FaceType.End, FaceJointType.Fingers, flute_sockets, fingerSides)
  end

  -- Splits a comma‑separated string into a numeric array.
  -- Includes validation, trimming, and safe conversion.
  local function splitToNumbers(input)
    -- Validate that input is a string
    if type(input) ~= "string" then
      return nil, "Input must be a string"
    end

    local result = {}

    -- Pattern explanation:
    -- "([^,]+)" captures sequences that are not commas.
    for part in input:gmatch("([^,]+)") do
      -- Trim whitespace around each part
      local trimmed = part:match("^%s*(.-)%s*$")

      -- Convert to number safely
      local num = tonumber(trimmed)

      if not num then
        return nil, "Invalid number found: " .. trimmed
      end

      table.insert(result, num)
    end

    return result
  end

  --[[ MakeInsetCountours will return a contour group of up which
  |    defines the rabbet for inset lids or bottoms taking into account
  |    if there are any missing faces which should not be rabbetted
  ]]
  function MakeInsetContours(width, height, thickness, start_point, facesToMake,
      create_tabs_for_missing_faces, name, facetype,
      inner_width, inner_height)

    -- compute x and y values for the 16 points that can
    -- be used for the various inset paths
    local x0 = start_point.x
    local x1 = x0 + thickness
    local x2 = x1 + inner_width
    local x3 = x0 + width
    local y0 = start_point.y
    local y1 = y0 + thickness
    local y2 = y1 + inner_height
    local y3 = y0 + height

    -- Table of all points that can make up the paths
    local points = {
      start_point,
      Point2D(x1, y0),
      Point2D(x2, y0),
      Point2D(x3, y0),
      Point2D(x0, y1),
      Point2D(x1, y1),
      Point2D(x2, y1),
      Point2D(x3, y1),
      Point2D(x0, y2),
      Point2D(x1, y2),
      Point2D(x2, y2),
      Point2D(x3, y2),
      Point2D(x0, y3),
      Point2D(x1, y3),
      Point2D(x2, y3),
      Point2D(x3, y3)
    }

    -- points to side mapping, numbers indicate position in
    -- table points above, numbers are the array index
    --
    -- 13 --- 14 ----------------------------- 15 --- 16
    -- |                    side 2                    |
    -- 9      10------------------------------ 11     12
    -- |      |                                |      |
    -- | end1 |                                | end2 |
    -- |      |                                |      |
    -- 5      6 ------------------------------ 7      8
    -- |                    side 1                    |
    -- 1 ---- 2 ------------------------------ 3 ---- 4
    --

    -- This table is the paths for each case definied by the bit field
    -- order is s1, s2, e1, e2 as a bit field
    -- the values are indexes into the points table above
    -- and can be visualised with the diagram

    local paths = {
      {""},                      -- 0 case, no path
      {"3,4,16,15,3"},           -- e2
      {"1,2,14,13,1"},           -- e1
      {"3,4,16,15,3", "1,2,14,13,1"}, -- e1 e2 (separate boxes)
      {"9,12,16,13,9"},          -- s2
      {"9,11,3,4,16,13,9"},      -- s2 e2
      {"1,2,10,12,16,13,1"},     -- s2 e1
      {"1,13,16,4,3,11,10,2,1"}, -- s2 e1 e2
      {"1,4,8,5,1"},             -- s1
      {"1,4,16,15,7,5,1"},       -- s1 e2
      {"1,4,8,6,14,13,1"},       -- s1 e1
      {"1,4,16,15,7,6,14,13,1"}, -- s1 e1 e2
      {"1,4,8,5,1", "9,12,16,13,9"}, -- s1 s2 (separate boxes)
      {"1,4,16,13,9,11,7,5,1"},  -- s1 s2 e2
      {"1,4,8,6,10,12,16,13,1"}, -- s1 s2 e1
      {"1,4,16,13,1", "6, 7, 11, 10, 6"} -- s1 s2 e1 e2 (separate boxes)
    }

    local indexOfPath = 1

    if (create_tabs_for_missing_faces) then
      indexOfPath = 16
    else
      if (facesToMake.end2) then
        -- lid vs bottom you need to flip the ends
        -- but not the sides
        if (facetype == FaceType.Lid) then
          indexOfPath = indexOfPath + 2^0
        else
          indexOfPath = indexOfPath + 2^1
        end
      end
      if (facesToMake.end1) then
        if (facetype == FaceType.Lid) then
          indexOfPath = indexOfPath + 2^1
        else
          indexOfPath = indexOfPath + 2^0
        end
      end
      if (facesToMake.side2) then
        indexOfPath = indexOfPath + 2^2
      end
      if (facesToMake.side1) then
        indexOfPath = indexOfPath + 2^3
      end
    end

    -- nothing to create
    if indexOfPath == 1 then
      return
    end

    -- grab the path for this inset

    local path = paths[indexOfPath]

    local inset_group = ContourGroup(true)

    -- the path could create more than one object so iterate each one
    -- create a contour for each set of points and add it together
    for i = 1, #path do
      local pointsForPath = splitToNumbers(path[i])
      local contour = Contour(0.0)
      contour:AppendPoint(points[pointsForPath[1]])
      for j = 2, #pointsForPath do
        contour:LineTo(points[pointsForPath[j]])
      end
      inset_group:AddTail( contour )
    end

    return inset_group

  end

  function MakeLid(width, height, thickness, dovetail, start_point, lidType, facesToMake, create_tabs_for_missing_faces, use_dovetails, name)

    local noLidTabs = (lidType == FaceJointType.Flat) or (lidType == FaceJointType.None) or (lidType == FaceJointType.Inset)

    local tablist = {}
    local dovetail_markers = {}
    local flute_sockets = {}
    local tab_width = dovetail.min_width
    local inner_width = width - 2*thickness
    local inner_height = height - 2*thickness

    -- local inner_start_point = start_point + Vector2D(thickness, thickness)

    -- Get corners of box
    local outer_blc = start_point
    local outer_brc = start_point + width*unit_x
    local outer_trc = start_point + width*unit_x + height* unit_y
    local outer_tlc = start_point + height*unit_y

    local num_flaps_w = math.floor( (0.5*inner_width)/tab_width)
    local num_flaps_h = math.floor( (0.5*inner_height)/tab_width)

    local tab_space_w = (inner_width - num_flaps_w*tab_width) / (num_flaps_w + 1)
    local tab_space_h = (inner_height - num_flaps_h*tab_width) / (num_flaps_h + 1)

    local fingerSides = ContourGroup(true) -- this will hold the sides of the fingers for the roundover layer if dogbones aren't made

    local contour = Contour(0.0)
    if (not noLidTabs) then
      contour:AppendPoint(start_point)

      --- blc -> brc connects to side1
      if (create_tabs_for_missing_faces or facesToMake.side1) then
        LineToVector(contour, (thickness + tab_space_w)*unit_x)
        AddMiddleOfLastSpanToList(contour, tablist)
        if use_dovetails then
          AddFemaleDoveTailsAlongLine(thickness, dovetail, unit_x, unit_y, contour, num_flaps_w, tab_space_w, dovetail_markers, flute_sockets)
        else
          AddFlapsAlongLine(thickness, tab_width, tab_space_w, unit_x, unit_y, contour, num_flaps_w, fingerSides)
        end
        contour:LineTo(outer_brc)
        AddMiddleOfLastSpanToList(contour, tablist)
      else
        LineToVector(contour, (thickness + tab_space_w)*unit_x)
        AddMiddleOfLastSpanToList(contour, tablist)
        contour:LineTo(outer_brc)
        AddMiddleOfLastSpanToList(contour, tablist)
      end

      -- brc --> trc connects to end1
      if (create_tabs_for_missing_faces or facesToMake.end1) then
        LineToVector(contour, (thickness + tab_space_h)*unit_y)
        AddMiddleOfLastSpanToList(contour, tablist)
        if use_dovetails then
          AddFemaleDoveTailsAlongLine(thickness, dovetail, unit_y, -unit_x, contour, num_flaps_h, tab_space_h, dovetail_markers, flute_sockets)
        else
          AddFlapsAlongLine(thickness, tab_width, tab_space_h, unit_y, -unit_x, contour, num_flaps_h, fingerSides)
        end
        contour:LineTo(outer_trc)
        AddMiddleOfLastSpanToList(contour, tablist)
      else
        LineToVector(contour, (thickness + tab_space_h) * unit_y)
        AddMiddleOfLastSpanToList(contour, tablist)
        contour:LineTo(outer_trc)
        AddMiddleOfLastSpanToList(contour, tablist)
      end

      -- trc --> tlc connects to side2
      if (create_tabs_for_missing_faces or facesToMake.side2) then
        LineToVector(contour, (thickness + tab_space_w)*-unit_x)
        AddMiddleOfLastSpanToList(contour, tablist)
        if use_dovetails then
          AddFemaleDoveTailsAlongLine(thickness, dovetail, -unit_x, -unit_y, contour, num_flaps_w, tab_space_w, dovetail_markers, flute_sockets)
        else
          AddFlapsAlongLine(thickness, tab_width, tab_space_w, -unit_x, -unit_y, contour, num_flaps_w, fingerSides)
        end
        contour:LineTo(outer_tlc)
        AddMiddleOfLastSpanToList(contour, tablist)
      else
        LineToVector(contour, (thickness + tab_space_w)*-unit_x)
        AddMiddleOfLastSpanToList(contour, tablist)
        contour:LineTo(outer_tlc)
        AddMiddleOfLastSpanToList(contour, tablist)
      end

      -- tlc --> trc connects to end2
      if (create_tabs_for_missing_faces or facesToMake.end2) then
        LineToVector(contour, (thickness + tab_space_h)* -unit_y)
        AddMiddleOfLastSpanToList(contour, tablist)
        if use_dovetails then
          AddFemaleDoveTailsAlongLine(thickness, dovetail, -unit_y, unit_x, contour, num_flaps_h, tab_space_h, dovetail_markers, flute_sockets)
        else
          AddFlapsAlongLine(thickness, tab_width, tab_space_h, -unit_y, unit_x, contour, num_flaps_h, fingerSides)
        end
        contour:LineTo(outer_blc)
        AddMiddleOfLastSpanToList(contour, tablist)
      else
        LineToVector(contour, (thickness + tab_space_h)* -unit_y)
        AddMiddleOfLastSpanToList(contour, tablist)
        contour:LineTo(outer_blc)
        AddMiddleOfLastSpanToList(contour, tablist)
      end

    else -- No tabs so just create outer profile contour
      contour:AppendPoint(start_point)
      LineToVector(contour, width*unit_x)
      AddMiddleOfLastSpanToList(contour, tablist)
      LineToVector(contour, height*unit_y)
      AddMiddleOfLastSpanToList(contour, tablist)
      LineToVector(contour, -width*unit_x)
      AddMiddleOfLastSpanToList(contour, tablist)
      LineToVector(contour, -height*unit_y)
      AddMiddleOfLastSpanToList(contour, tablist)
    end

    -- This is the contour that will be used to cut the pocket in the lid
    -- when doing an inset, needs to accomodate missing faces machining though
    -- local inset_contour = MakeInsetContour(width, height, thickness, start_point, facesToMake,
    --                           create_tabs_for_missing_faces, name, inner_width, inner_height)

    local inset_contours = MakeInsetContours(width, height, thickness, start_point, facesToMake,
      create_tabs_for_missing_faces, name, FaceType.Lid,
      inner_width, inner_height)

    return Face(contour, inset_contours, dovetail_markers, tablist, name, FaceType.Lid, lidType, flute_sockets, fingerSides)
  end
