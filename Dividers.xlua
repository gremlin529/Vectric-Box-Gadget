-- VECTRIC LUA SCRIPT
-- Dividers.xlua
--
-- Dividers across the width of the box: their options (defaults, units, spacing,
-- saving), the dialog side (fields, reading back, validation, registry), the
-- divider parts themselves (Finger: through fingers into slots; Groove: tongues in
-- grooves), the slots / grooves they need in the walls, bottom and lid, and the
-- toolpaths for those.
--
-- Loaded after CreateFaces.xlua (uses Face, FaceType, FaceJointType,
-- IsOpenLidType, CreatePocketToolpathForFaces) and before DisplayDialog.xlua.
-- BottomPanelUndersideHeight (DisplayDialog.xlua) is only called at run time.
--                                                             -- by Claude 11/26/2026

local unit_x = Vector2D(1,0)
local unit_y = Vector2D(0,1)

FaceType.Divider = 5   -- divider across the width
G_maxDividers = 50     -- most dividers the dialog takes (DividerCountField / DividerSpace<n>Field) - was 10 -- by Claude 11/27/2026
G_dividerSlotLayerName = "Divider Slots"   -- tool paths for the through slots the divider fingers go into
G_dividerLayerName = "Divider Panel"         -- dividers on sheets of their own: their outlines -- by Claude 11/27/2026
G_dividerCutoutLayerName = "CutOut Dividers" -- ... and their cutout vectors
DividerJointCodes = { Finger = 1, Groove = 2 }   -- options.dividerJoint as a number (document variables, Export)
DividerModeCodes = { Count = 1, Spacing = 2 }    -- options.dividerMode as a number (document variables, Export) -- by Claude 11/27/2026

-- LineTo that skips a (near) zero length span.
local function LineToIfNeeded(contour, pt)
  local cur = contour.EndPoint2D
  if (math.abs(cur.x - pt.x) > 0.000001 or math.abs(cur.y - pt.y) > 0.000001) then
    contour:LineTo(pt)
  end
end

--[[  -------------- Divider options --------------------------------------------------
|
|  dividerSpace<k> = clear gap in front of divider k; 0 = not set yet (filled with
|  an even spacing by ResolveDividerSpacing). dividerInset = "Top inset".
|  dividerJoint = "Finger" or "Groove". dividerThickness = the dividers' own
|  thickness (0 = the material thickness); another thickness than the material
|  puts them on sheets of their own (DividersOnSeparateSheets). -- by Claude 11/27/2026
|
]]
function InitDividerOptions(options)
  options.makeDividers = false
  options.dividerCount = 1
  options.dividerInset = 0
  options.dividerJoint = "Finger"
  options.dividerThickness = 0
  options.dividerMode = "Count"   -- "Count" (Count + Space fields) or "Spacing" (as many as fit at dividerMinGap) -- by Claude 11/27/2026
  options.dividerMinGap = 0       -- Spacing mode: the smallest gap allowed; 0 = not set yet (see ResolveDividerSpacing)
  for k = 1, G_maxDividers do
    options["dividerSpace" .. k] = 0
  end
end

-- The dividers' own thickness: the Thickness field, or the material thickness.
function DividerThickness(options)
  local td = tonumber(options.dividerThickness) or 0
  if td > 0.0001 then
    return td
  end
  return options.thickness
end

-- Not the material thickness: cut from other stock.
function DividerThicknessDiffers(options)
  return math.abs(DividerThickness(options) - options.thickness) > 0.0001
end

-- Dividers of another thickness than the material are cut from other stock, so
-- they go on sheets of their own (several may share one, but no box parts). At
-- the material thickness they are laid out with the box parts. (The "Dividers on
-- separate sheet" checkbox this replaced was dropped 11/27/2026.)  -- by Claude 11/27/2026
function DividersOnSeparateSheets(options)
  return DividerCount(options) > 0 and DividerThicknessDiffers(options)
end

-- Every numeric divider option (document variables, Export).
function DividerDocumentFieldNames()
  local names = { "makeDividers", "dividerCount", "dividerInset", "dividerThickness", "dividerMinGap" }
  for k = 1, G_maxDividers do
    names[#names + 1] = "dividerSpace" .. k
  end
  return names
end

-- The divider options that are lengths (rescaled between inches and mm).
function DividerLengthFieldNames()
  local names = { "dividerInset", "dividerThickness", "dividerMinGap" }
  for k = 1, G_maxDividers do
    names[#names + 1] = "dividerSpace" .. k
  end
  return names
end

-- Rescale the divider lengths when the job's units changed (main), like the
-- other lengths there.
function ConvertDividerUnits(options, multiplier)
  for _, name in ipairs(DividerLengthFieldNames()) do
    options[name] = Truncate((options[name] or 0) * multiplier, 2)
  end
end

-- Before the dialog opens: the Thickness starts at the material thickness unless
-- dividers are in use with a thickness of their own; and if the saved spacing
-- doesn't fit this box (or nothing was saved yet), start from an even spacing.
function ResolveDividerSpacing(options)
  if not options.makeDividers or (tonumber(options.dividerThickness) or 0) <= 0.0001 then
    options.dividerThickness = options.thickness
  end
  local n = math.max(1, math.min(math.floor((tonumber(options.dividerCount) or 1) + 0.5), G_maxDividers))
  options.dividerCount = n
  local td = DividerThickness(options)
  local spacing_ok = true
  local used = options.thickness
  for k = 1, n do
    local space = options["dividerSpace" .. k] or 0
    if space <= 0 then spacing_ok = false end
    used = used + space + td
  end
  if not spacing_ok or used >= options.depth - options.thickness then
    SetEvenDividerSpaces(options)
  end
  -- Spacing mode's minimum gap: start from the (even) first space when nothing
  -- usable is saved.                                       -- by Claude 11/27/2026
  if options.dividerMode ~= "Spacing" then options.dividerMode = "Count" end
  if (tonumber(options.dividerMinGap) or 0) <= 0.0001 then
    options.dividerMinGap = options.dividerSpace1 or 0
  end
end

--[[  -------------- Dialog side --------------------------------------------------
|
|  The fields live in Simple_Box_Creator_dev.html (Faces To Machine: MakeDividers;
|  Divider Options: DividerJointSelect, DividerCountField, DividerInsetField,
|  DividerThicknessField, and the 50 DividerSpace<k>Field boxes - written by a
|  script as the page loads). The Space boxes are NOT registered with Lua one by
|  one: all of their values travel as ONE hidden text field, DividerSpacesList
|  ("s1,s2,...,s50"), that the page keeps up to date - one read per live check
|  instead of 50. Their messages come back the same way, InvalidDividerSpaces
|  ("k:message|k:message"). Other hidden fields: InvalidDividers,
|  InvalidDividerInset, InvalidDividerCount, InvalidDividerThickness. The joint
|  dropdown's texts are read back.                           -- by Claude 11/27/2026
]]

-- The count box holds a whole number: an integer field where the host has one.
local function AddCountField(dialog, id, value)
  if dialog.AddIntegerField ~= nil then
    dialog:AddIntegerField(id, value)
  else
    dialog:AddDoubleField(id, value)
  end
end

local function GetCountField(dialog, id)
  if dialog.GetIntegerField ~= nil then
    return dialog:GetIntegerField(id)
  end
  return dialog:GetDoubleField(id)
end

local function UpdateCountField(dialog, id, value)
  if dialog.UpdateIntegerField ~= nil then
    dialog:UpdateIntegerField(id, value)
  else
    dialog:UpdateDoubleField(id, value)
  end
end

local function ClampDividerCount(value)
  return math.max(1, math.min(math.floor((tonumber(value) or 1) + 0.5), G_maxDividers))
end

-- All G_maxDividers spaces as "s1,s2,..." for DividerSpacesList; `get(k)` gives
-- space k. %.6f with the trailing zeros trimmed, so it reads back exactly what
-- the boxes show.
local function DividerSpacesText(get)
  local parts = {}
  for k = 1, G_maxDividers do
    local s = string.format("%.6f", tonumber(get(k)) or 0)
    s = string.gsub(s, "0+$", "")
    s = string.gsub(s, "%.$", "")
    parts[k] = s
  end
  return table.concat(parts, ",")
end

function AddDividerDialogFields(dialog, options)
  dialog:AddCheckBox("MakeDividers", options.makeDividers)
  AddCountField(dialog, "DividerCountField", ClampDividerCount(options.dividerCount))
  dialog:AddTextField("DividerSpacesList", DividerSpacesText(function(k) return options["dividerSpace" .. k] end))
  dialog:AddTextField("InvalidDividerSpaces", "")
  dialog:AddTextField("InvalidDividers", "")
  dialog:AddTextField("InvalidDividerCount", "")
  dialog:AddDoubleField("DividerInsetField", options.dividerInset or 0)
  dialog:AddTextField("InvalidDividerInset", "")
  dialog:AddDoubleField("DividerThicknessField", DividerThickness(options))
  dialog:AddTextField("InvalidDividerThickness", "")
  -- the dropdown says Fingers / Grooved; options.dividerJoint (and what is saved)
  -- stays "Finger" / "Groove", so earlier settings still load -- by Claude 11/26/2026
  dialog:AddDropDownList("DividerJointSelect", options.dividerJoint == "Groove" and "Grooved" or "Fingers")
  -- Count / Spacing (option texts read back as-is) and Spacing mode's minimum gap -- by Claude 11/27/2026
  dialog:AddDropDownList("DividerModeSelect", options.dividerMode == "Spacing" and "Spacing" or "Count")
  dialog:AddDoubleField("DividerMinGapField", options.dividerMinGap or 0)
  dialog:AddTextField("InvalidDividerMinGap", "")
end

function ReadDividerOptionsFromDialog(dialog, options)
  options.dividerMode = (dialog:GetDropDownListValue("DividerModeSelect") == "Spacing") and "Spacing" or "Count"   -- by Claude 11/27/2026
  options.dividerMinGap = dialog:GetDoubleField("DividerMinGapField") or 0
  options.makeDividers = dialog:GetCheckBox("MakeDividers")
  options.dividerCountEntered = GetCountField(dialog, "DividerCountField")   -- as typed, for ValidateDividers
  options.dividerCount = ClampDividerCount(options.dividerCountEntered)
  options.dividerInset = dialog:GetDoubleField("DividerInsetField") or 0
  options.dividerThickness = dialog:GetDoubleField("DividerThicknessField") or 0
  local joint = dialog:GetDropDownListValue("DividerJointSelect")
  options.dividerJoint = (joint == "Grooved" or joint == "Groove") and "Groove" or "Finger"
  -- every space in one read: "s1,s2,...". A missing or unreadable entry counts as
  -- 0 (not filled in), which ValidateDividers flags for the spaces in use.
  local k = 0
  for item in string.gmatch((dialog:GetTextField("DividerSpacesList") or "") .. ",", "([^,]*),") do
    k = k + 1
    if k > G_maxDividers then break end
    options["dividerSpace" .. k] = tonumber(item) or 0
  end
end

function SaveDividerRegistry(registry, options)
  registry:SetBool("MakeDividers", options.makeDividers)
  registry:SetDouble("DividerCount", options.dividerCount or 1)
  registry:SetDouble("DividerInset", options.dividerInset or 0)
  registry:SetDouble("DividerThickness", options.dividerThickness or 0)
  registry:SetString("DividerJoint", options.dividerJoint == "Groove" and "Groove" or "Finger")
  registry:SetString("DividerMode", options.dividerMode == "Spacing" and "Spacing" or "Count")   -- by Claude 11/27/2026
  registry:SetDouble("DividerMinGap", options.dividerMinGap or 0)
  for k = 1, G_maxDividers do
    registry:SetDouble("DividerSpace" .. k, options["dividerSpace" .. k] or 0)
  end
end

function LoadDividerRegistry(registry, options)
  options.makeDividers = registry:GetBool("MakeDividers", options.makeDividers)
  options.dividerCount = registry:GetDouble("DividerCount", options.dividerCount)
  options.dividerInset = registry:GetDouble("DividerInset", options.dividerInset or 0)
  options.dividerThickness = registry:GetDouble("DividerThickness", options.dividerThickness or 0)
  options.dividerJoint = (registry:GetString("DividerJoint", options.dividerJoint or "Finger") == "Groove") and "Groove" or "Finger"
  options.dividerMode = (registry:GetString("DividerMode", options.dividerMode or "Count") == "Spacing") and "Spacing" or "Count"   -- by Claude 11/27/2026
  options.dividerMinGap = registry:GetDouble("DividerMinGap", options.dividerMinGap or 0)
  for k = 1, G_maxDividers do
    options["dividerSpace" .. k] = registry:GetDouble("DividerSpace" .. k, options["dividerSpace" .. k] or 0)
  end
end

-- Import (OnLuaButton_ImportSettings): put the imported divider values into the
-- dialog. `values` holds the file's numbers, already converted to the job's units;
-- `options` the current settings, which keep any space the file doesn't have
-- (an older file with fewer spaces). The page copies DividerSpacesList into the
-- Space boxes when it sees the import token change.
function ImportDividerSettings(dialog, values, options)
  dialog:UpdateTextField("DividerSpacesList", DividerSpacesText(function(k)
    local v = values["dividerSpace" .. k]
    if v == nil and options then v = options["dividerSpace" .. k] end
    return v
  end))
  if values.dividerInset ~= nil then dialog:UpdateDoubleField("DividerInsetField", values.dividerInset) end
  if values.dividerThickness ~= nil and values.dividerThickness > 0 then
    dialog:UpdateDoubleField("DividerThicknessField", values.dividerThickness)
  end
  if values.makeDividers ~= nil then dialog:UpdateCheckBox("MakeDividers", values.makeDividers ~= 0) end
  if values.dividerMode ~= nil then   -- by Claude 11/27/2026
    dialog:UpdateDropDownListValue("DividerModeSelect", values.dividerMode == DividerModeCodes.Spacing and "Spacing" or "Count")
  end
  if values.dividerMinGap ~= nil and values.dividerMinGap > 0 then
    dialog:UpdateDoubleField("DividerMinGapField", values.dividerMinGap)
  end
  if values.dividerCount ~= nil then
    UpdateCountField(dialog, "DividerCountField", ClampDividerCount(values.dividerCount))
  end
  if values.dividerJoint ~= nil then
    dialog:UpdateDropDownListValue("DividerJointSelect", values.dividerJoint == DividerJointCodes.Groove and "Grooved" or "Fingers")
  end
end

--[[  -------------- ValidateDividers --------------------------------------------------
|
|  Count: a whole number from 1 to G_maxDividers. Thickness: more than 0. Every
|  space in use must be more than 0, and the dividers (at their own thickness) must
|  still fit in the inside depth with room to spare behind the last one. Top inset:
|  0 or more, and not all of the divider. Finger: enough height for a side finger,
|  and a tool that fits the slots (one divider thickness wide). Groove: the
|  allowance must leave a tongue, and the tool must fit the grooves.
|
|  Space problems go to InvalidDividerSpaces as "k:message|k:message" (the page
|  marks those Space fields red), count / inset / thickness to their own
|  Invalid... field, the rest to InvalidDividers (shown in red under the spacing
|  fields). report_as_dialog as for the other validators in DisplayDialog.xlua;
|  set_text writes a hidden field (DisplayDialog's cached SetDialogText), decimals
|  is the number of places in the messages.                 -- updated by Claude 11/27/2026
|
]]
function ValidateDividers(dialog, options, report_as_dialog, effective_diameter, set_text, decimals)
  local messages = {}
  local general = ""
  local inset_message = ""
  local count_message = ""
  local thickness_message = ""
  local min_gap_message = ""   -- Spacing mode -- by Claude 11/27/2026
  local spacing = DividerUsesSpacing(options)
  local n = DividerCount(options)
  local fmt = "%." .. (decimals or 3) .. "f"

  if options.makeDividers then
    if spacing then
      -- Spacing mode: a minimum gap that leaves room for at least one divider
      local g = tonumber(options.dividerMinGap) or 0
      if g <= 0.0001 then
        min_gap_message = "The minimum gap between dividers must be greater than 0."
      elseif n < 1 then
        min_gap_message = string.format("Not even one divider fits with gaps of at least " .. fmt .. " - the inside depth is only " .. fmt .. ". Use a smaller gap.",
          g, options.depth - 2*options.thickness)
      end
    else
      local entered = tonumber(options.dividerCountEntered or options.dividerCount)
      if entered == nil or entered < 1 or entered > G_maxDividers or math.abs(entered - math.floor(entered + 0.5)) > 0.0001 then
        count_message = string.format("The number of dividers must be a whole number from 1 to %d.", G_maxDividers)
      end
    end
    if (tonumber(options.dividerThickness) or 0) <= 0.0001 then
      thickness_message = "The divider thickness must be greater than 0."
    end
  end

  if n > 0 then
    local td = DividerThickness(options)
    local inset = options.dividerInset or 0
    if inset < 0 then
      inset_message = "Top inset must be 0 or more."
    else
      -- how tall the dividers would be with no inset at all
      local saved = options.dividerInset
      options.dividerInset = 0
      local full = DividerJoints(options, options.facesToMake)
      options.dividerInset = saved
      local full_height = full.z_top - full.z_bot
      if inset >= full_height - 0.0001 then
        inset_message = string.format("Top inset " .. fmt .. " leaves nothing of the dividers - they are only " .. fmt .. " tall without it.", inset, full_height)
      end
    end

    for k = 1, n do
      if spacing then break end   -- no Space fields in Spacing mode -- by Claude 11/27/2026
      local space = options["dividerSpace" .. k]
      if not space or space <= 0.0001 then
        messages[k] = string.format("Space %d must be greater than 0.", k)
      end
    end
    local last = DividerLastSpace(options)
    if last <= 0.0001 then
      local inside = options.depth - 2*options.thickness
      local used = inside - last
      messages[n] = messages[n] or string.format("The dividers don't fit: the spaces plus %d divider(s) of " .. fmt .. " come to " .. fmt .. ", but the inside depth is only " .. fmt .. ".", n, td, used, inside)
      general = messages[n]
    end

    local j = DividerJoints(options, options.facesToMake)
    local fw = DividerFingerWidths(options)
    local divider_height = j.z_top - j.z_bot
    local grooves = DividerUsesGrooves(options)
    if grooves and general == "" then
      local allowance = math.max(0, options.allowance or 0)
      local gw = DividerGrooveWidth(options)
      local raw_dia = (effective_diameter or 0) + 2*allowance   -- effective = diameter - 2 x allowance
      if allowance >= DividerGrooveDepth(options) - 0.0001 then
        general = string.format("The allowance " .. fmt .. " leaves the dividers no tongue to sit in their grooves (" .. fmt .. " deep). Use a smaller allowance.", allowance, DividerGrooveDepth(options))
      elseif not options.no_toolpath and raw_dia > 0 and raw_dia >= gw - 0.0001 then
        general = string.format("The divider grooves are only " .. fmt .. " wide (divider thickness + allowance), the tool (" .. fmt .. ") does not fit in them. Use a smaller tool.", gw, raw_dia)
      end
    end
    if not grooves and general == "" and inset_message == "" and (j.side1 or j.side2) and divider_height <= (fw.side or 0) + 0.0001 then
      general = string.format("The dividers are only " .. fmt .. " tall inside the box - too short for a side joint of " .. fmt .. ". Use a smaller side joint width or a taller box.", divider_height, fw.side or 0)
    end
    if not grooves and general == "" and not options.no_toolpath and effective_diameter
        and effective_diameter > 0 and td <= effective_diameter + 0.0001 then
      general = string.format("The divider slots are only " .. fmt .. " wide (the divider thickness), the tool does not fit in them (" .. fmt .. "). Use a smaller tool.", td, effective_diameter)
    end
  end

  if report_as_dialog then
    for _, m in ipairs({ count_message, min_gap_message, thickness_message }) do
      if m ~= "" then
        DisplayMessageBox(m)
        return false
      end
    end
    for k = 1, n do
      if messages[k] then
        DisplayMessageBox(messages[k])
        return false
      end
    end
    if inset_message ~= "" then
      DisplayMessageBox(inset_message)
      return false
    end
    if general ~= "" then
      DisplayMessageBox(general)
      return false
    end
    return true
  end

  local list = {}
  for k = 1, n do
    if messages[k] then
      list[#list + 1] = k .. ":" .. string.gsub(messages[k], "[|]", "/")
    end
  end
  set_text(dialog, "InvalidDividerSpaces", table.concat(list, "|"))
  set_text(dialog, "InvalidDividers", general)
  set_text(dialog, "InvalidDividerInset", inset_message)
  set_text(dialog, "InvalidDividerCount", count_message)
  set_text(dialog, "InvalidDividerThickness", thickness_message)
  set_text(dialog, "InvalidDividerMinGap", min_gap_message)   -- by Claude 11/27/2026
  return general == "" and inset_message == "" and count_message == "" and min_gap_message == "" and thickness_message == "" and next(messages) == nil
end

--[[  -------------- Building the box --------------------------------------------------
|
|  Hooks the rest of the gadget calls: add the dividers (and their slots /
|  grooves) to the faces, move their extra contours with a face, and the
|  toolpaths for the slots and grooves.
|
]]

-- CreateBoxFaces: slots / grooves in the walls, bottom and lid, then the dividers.
function AddDividersToFaces(faces, options, facesToMake)
  local n = DividerCount(options)
  if n == 0 then
    return
  end
  AddDividerSlotsToFaces(faces, options, facesToMake)
  for k = 1, n do
    faces[#faces + 1] = MakeDividerFace(options, facesToMake, k)
  end
end

-- LayoutFacesOnSheets / CreateBoxToolpaths: with DividersOnSeparateSheets the
-- dividers come out of the list of faces laid out with the box parts and get
-- sheets of their own (several dividers may share one). Returns the remaining
-- faces and the dividers; with them on the box's sheets, all faces and {}.
--                                                             -- by Claude 11/27/2026
function SplitOffDividerFaces(faces, options)
  if not DividersOnSeparateSheets(options) then
    return faces, {}
  end
  local rest, dividers = {}, {}
  for i = 1, #faces do
    if faces[i].facetype == FaceType.Divider then
      dividers[#dividers + 1] = faces[i]
    else
      rest[#rest + 1] = faces[i]
    end
  end
  return rest, dividers
end

-- Name of the dividers' (first) sheet. In brackets, so SheetNameForIndex numbers
-- any more as "-2", "-3" instead of counting up the thickness at the end.
function DividerSheetName(options)
  return string.format("Dividers (%g)", DividerThickness(options))
end

-- Cutout depth / name for the dividers on their own sheets: their own thickness.
function DividerCutoutName(options)
  return string.format("Cut Out Dividers (%g)", DividerThickness(options))
end

-- TransformFace: the slot / groove contours a face carries move with it.
function TransformDividerContours(face, xform)
  if (face.slot_contours ~= nil) then
    face.slot_contours:Transform(xform)
  end
  if (face.divider_groove_contours ~= nil) then
    face.divider_groove_contours:Transform(xform)
  end
end

-- CreateBoxToolpaths, per sheet: the slot outlines go on the Box layer with the
-- parts, their tool paths (dogboned like the cutout) on their own layer. Only
-- full-thickness parts ever carry slots - a separate (Grooved) bottom/lid panel
-- never joints into a divider. Returns the tool path objects, or nil.
function AddDividerSlotVectors(job, options, main_faces, offset_radius, box_layer_name)
  local slot_outlines = CadObjectList(true)
  local slot_paths = CadObjectList(true)
  local slot_count = 0
  local slot_dogbones = options.create_dogbones or options.dovetailJoint
  for i = 1, #main_faces do
    local slots = main_faces[i].slot_contours
    if slots ~= nil then
      local pos = slots:GetHeadPosition()
      while pos ~= nil do
        local slot
        slot, pos = slots:GetNext(pos)
        slot_outlines:AddTail(CreateCadContour(slot))
        local path = DividerSlotToolPath(slot, offset_radius, slot_dogbones)
        if path ~= nil then
          slot_paths:AddTail(CreateCadContour(path))
          slot_count = slot_count + 1
        end
      end
    end
  end
  if slot_count == 0 then
    return nil
  end
  AddCadListToJob(job, slot_outlines, box_layer_name)
  return AddCadListToJob(job, slot_paths, G_dividerSlotLayerName)
end

-- The slots, cut right through before the parts are cut free.
function CreateDividerSlotToolpath(job, options, slot_objects)
  if slot_objects == nil then
    return
  end
  CreateCutoutToolpath(options.tool, job, options.thickness, options.sideOrAllTabWidth,
    G_dividerSlotLayerName, slot_objects, "Divider Slots")
end

-- Dividers set to Groove: the grooves in Left / Right (and the bottom / lid) the
-- tongues sit in, half a material thickness deep. Their width (material
-- thickness + allowance) is already in the vectors, so the pocket gets no
-- allowance of its own.
function CreateDividerGrooveToolpath(job, options, faces, tool, layer_name)
  return CreatePocketToolpathForFaces(job, options, faces, tool, layer_name, "Divider Grooves",
    function(face)
      return face.divider_groove_contours
    end,
    function()
      return DividerGrooveDepth(options)
    end,
    0)
end

--[[  -------------- Dividers --------------------------------------------------
|
|  Dividers run across the width (parallel to Front and Back) at the spacing
|  set in the dialog. Each one is finger jointed into the walls it touches,
|  with plain box-joint fingers even on a dovetailed box: through fingers, one
|  material thickness long, that pass right through slots in Left and Right,
|  and through the bottom and the lid when those are Fingers, Flat or Inset.
|  A Grooved bottom or lid slides in and out, so the divider never joints into
|  it: it stands on the bottom panel and stops under the lid groove. An open
|  top or no bottom has nothing to joint into.
|
|  Coordinates: y_box is measured along the depth from Front's outer face,
|  z from the walls' bottom edge. "Space k" in the dialog is the clear gap in
|  front of divider k (from Front's inside face, or from the divider before
|  it). Whatever is left behind the last divider goes to the Back. A "Top
|  inset" (options.dividerInset) above 0 makes the dividers that much shorter
|  at the top, without fingers into the lid (see DividerJoints).
|
|  The divider part is drawn with x across the box width (Left at x = 0) and
|  y = z. The slots are cut by their own "Divider Slots" toolpath; see
|  DividerSlotToolPath.
|
|  Added by Claude 11/26/2026
|
]]

-- Number of dividers actually being made (0 when the Dividers box is unticked).
function DividerCount(options)
  if not options.makeDividers then
    return 0
  end
  if DividerUsesSpacing(options) then
    return DividerSpacingCount(options)   -- as many as fit at the minimum gap -- by Claude 11/27/2026
  end
  local n = math.floor((tonumber(options.dividerCount) or 0) + 0.5)
  return math.max(0, math.min(n, G_maxDividers))
end

--[[  -------------- Spacing mode --------------------------------------------------
|
|  "Spacing" instead of "Count" in the dialog: the box takes a minimum gap and the
|  gadget makes as many dividers as fit with every gap (the one behind the last
|  divider included) at least that big - all gaps equal. n dividers of thickness td
|  leave n + 1 gaps of (inside - n x td) / (n + 1), which stays >= g while
|  n <= (inside - g) / (g + td). Capped at G_maxDividers. The Space fields aren't
|  used in this mode.                                         -- by Claude 11/27/2026
|
]]
function DividerUsesSpacing(options)
  return options.dividerMode == "Spacing"
end

function DividerSpacingCount(options)
  local g = tonumber(options.dividerMinGap) or 0
  if g <= 0.0001 then
    return 0
  end
  local inside = options.depth - 2*options.thickness
  local n = math.floor((inside - g) / (g + DividerThickness(options)) + 0.000001)
  return math.max(0, math.min(n, G_maxDividers))
end

-- The gap in front of divider k: the Space field, or in Spacing mode the even gap.
function DividerSpace(options, k)
  if DividerUsesSpacing(options) then
    local n = DividerSpacingCount(options)
    local inside = options.depth - 2*options.thickness
    return (inside - n*DividerThickness(options)) / (n + 1)
  end
  return options["dividerSpace" .. k] or 0
end

-- y_box of each divider's front face. The walls are the material thickness (t),
-- each divider its own thickness (td).                -- td: by Claude 11/27/2026
function DividerPositions(options)
  local t = options.thickness
  local td = DividerThickness(options)
  local positions = {}
  local y = t
  for k = 1, DividerCount(options) do
    y = y + DividerSpace(options, k)   -- Space field, or the even gap in Spacing mode -- by Claude 11/27/2026
    positions[k] = y
    y = y + td
  end
  return positions
end

-- Clear space behind the last divider, up to Back's inside face.
function DividerLastSpace(options)
  local t = options.thickness
  local n = DividerCount(options)
  local behind = t
  if n > 0 then
    behind = DividerPositions(options)[n] + DividerThickness(options)
  end
  return (options.depth - t) - behind
end

-- Fill every divider space with an even spacing for the current count. Used
-- when nothing usable has been saved yet.
function SetEvenDividerSpaces(options)
  local t = options.thickness
  local td = DividerThickness(options)
  local n = math.max(1, math.min(math.floor((tonumber(options.dividerCount) or 1) + 0.5), G_maxDividers))
  local even = ((options.depth - 2*t) - n*td) / (n + 1)
  even = math.max(0, Truncate(even, 3))
  for k = 1, G_maxDividers do
    options["dividerSpace" .. k] = even
  end
end

-- Finger widths: the divider's side fingers use the side joint width, its
-- bottom / top fingers the bottom / lid joint widths (the side width too
-- unless "Show all joint widths" is on, like everywhere else).
function DividerFingerWidths(options)
  local side = options.sideOrAllTabWidth
  local bottom, lid = side, side
  if options.useAllJointWidths then
    bottom = options.bottomTabWidth or side
    lid = options.lidTabWidth or side
  end
  return { side = side, bottom = bottom, lid = lid }
end

-- Where the divider's body starts and ends (z_bot / z_top) and which of its
-- four edges get fingers.
function DividerJoints(options, facesToMake)
  local t = options.thickness
  local h = options.height
  local tabsForMissing = options.create_tabs_for_missing_faces
  local j = {}

  local bt = options.bottomType
  if (bt == FaceJointType.Fingers or bt == FaceJointType.Flat or bt == FaceJointType.Inset) then
    -- the bottom panel fills z = 0..t under the divider, whatever its edge joint
    j.z_bot = t
    j.bottom = (facesToMake.bottom or tabsForMissing) and true or false
  elseif (bt == FaceJointType.Grooved) then
    -- stand on the sliding panel (never below the top of its groove)
    local panel_top = BottomPanelUndersideHeight(options) + (options.bottomThickness or t)
    j.z_bot = math.max(panel_top, options.bottomGrooveOffset or 0)
    j.bottom = false
  else
    j.z_bot = 0
    j.bottom = false
  end

  local lt = options.lidType
  if (lt == FaceJointType.Fingers or lt == FaceJointType.Flat or lt == FaceJointType.Inset) then
    j.z_top = h - t
    j.lid = (facesToMake.lid or tabsForMissing) and true or false
  elseif (lt == FaceJointType.Grooved) then
    -- stop at the lid's underside (the lower edge of the lid groove)
    j.z_top = h - (options.lidGrooveOffset or 0)
    j.lid = false
  elseif (lt == FaceJointType.OpenChamfer) then
    -- stay below the lower of the two ends, so it never sticks up out of a chamfer
    j.z_top = math.min(h, options.end1Height or h, options.end2Height or h)
    j.lid = false
  else
    j.z_top = h
    j.lid = false
  end

  -- Top inset: the divider stops this much lower than it otherwise would (the
  -- top of the walls, or the underside of the lid) and so no longer reaches the
  -- lid to finger into it.                                   -- by Claude 11/26/2026
  local inset = tonumber(options.dividerInset) or 0
  if inset > 0.0001 then
    j.z_top = j.z_top - inset
    j.lid = false
  end

  j.side1 = (facesToMake.side1 or tabsForMissing) and true or false
  j.side2 = (facesToMake.side2 or tabsForMissing) and true or false
  return j
end

-- Fingers along an edge `length` long, `width` wide, evenly spaced with a gap
-- at both ends (same rule as the box's own edges, but at least one finger
-- whenever the edge is longer than one finger). Returns { {from, to}, ... }
-- measured from the start of the edge. Symmetric, so it is the same from
-- either end.
function DividerFingerSpans(length, width)
  local spans = {}
  if (width == nil or width <= 0.0001 or length <= width + 0.0001) then
    return spans
  end
  local n = math.max(1, math.floor((0.5*length) / width))
  local gap = (length - n*width) / (n + 1)
  for k = 1, n do
    local a = gap + (k - 1)*(width + gap)
    spans[k] = { a, a + width }
  end
  return spans
end

-- Draws one edge of the divider from `start` along `along`, with a finger
-- sticking out by `depth` (towards `out`) for each span. The contour must
-- already end at `start`.
local function DrawDividerEdge(contour, start, along, out, length, spans, depth, tablist, fingerSides)
  local function at(d)
    return start + d*along
  end
  local prev = 0
  for k = 1, #spans do
    local a = spans[k][1]
    local b = spans[k][2]
    if (a - prev > 0.000001) then
      contour:LineTo(at(a))
      tablist[#tablist + 1] = at(0.5*(prev + a))
    end
    local a_out = at(a) + depth*out
    local b_out = at(b) + depth*out
    if fingerSides then
      fingerSides:AddTail(MakeLine(at(a), a_out))
      fingerSides:AddTail(MakeLine(b_out, at(b)))
    end
    contour:LineTo(a_out)
    contour:LineTo(b_out)
    contour:LineTo(at(b))
    prev = b
  end
  if (length - prev > 0.000001) then
    contour:LineTo(at(length))
    tablist[#tablist + 1] = at(0.5*(prev + length))
  end
end

--[[  -------------- Grooved dividers --------------------------------------------------
|
|  "Dividers: Groove" instead of fingers: each divider sits in grooves (dados)
|  milled into the inside face of Left / Right - and of the bottom / lid wherever
|  the finger version would joint into them (DividerJoints). A groove is the
|  material thickness + the allowance wide (centred on the divider) and half a
|  material thickness deep. The divider gets a tongue on each grooved edge that
|  reaches into it (groove depth less the allowance, for a little end play), its
|  corners notched where a wall meets the bottom / lid.
|
|  Each groove runs one tool radius past the divider's tongue at a closed end, so
|  the round corners the bit leaves there can't stop the square tongue (the
|  extra sits inside the joint between wall and panel, out of sight). With a Top
|  inset the side grooves stop above the divider by the allowance (+ that run-on)
|  rather than going on up the wall (11/26/2026). Otherwise, on an open
|  top (no lid or Open Chamfer) the grooves in Left / Right run out through the
|  top edge, so the dividers lift in and out. With a sliding (Grooved) lid they
|  stop at the lid groove, like the divider (11/26/2026).
|
|  Added by Claude 11/26/2026
|
]]
function DividerUsesGrooves(options)
  return options.dividerJoint == "Groove"
end

function DividerGrooveDepth(options)
  return 0.5*options.thickness
end

-- the divider's own thickness + the allowance (the depth stays half the WALL
-- thickness, see DividerGrooveDepth)                  -- td: by Claude 11/27/2026
function DividerGrooveWidth(options)
  return DividerThickness(options) + math.max(0, options.allowance or 0)
end

-- how far the divider's tongues reach into the grooves
local function DividerTongue(options)
  return math.max(0, DividerGrooveDepth(options) - math.max(0, options.allowance or 0))
end

-- the top is open, so Left / Right's grooves can run out through it
-- Not with a sliding (Grooved) lid: the divider stops at the lid's underside, so
-- its grooves stop there too (at the lid groove) rather than running on up
-- across the lid groove to the top edge.                       -- by Claude 11/26/2026
local function DividerGroovesOpenTop(options)
  return IsOpenLidType(options.lidType)
end

-- tool radius, in job units, that a closed groove end is run on by
local function DividerGrooveRunOn(options)
  local r = 0.125
  if Tool_ok(options.tool) then
    r = 0.5*ConvertUnitsFrom(options.tool.ToolDia, options.tool, MaterialBlock())
  end
  return r
end

-- The divider part for grooves: drawn like the finger one (Left at x = 0, y = z),
-- body inside width x z_bot..z_top, plus a tongue along each grooved edge.
function MakeGroovedDividerFace(options, facesToMake, index)
  local t = options.thickness
  local sp = options.start_point
  local j = DividerJoints(options, facesToMake)
  local g = DividerTongue(options)
  local gL = j.side1 and g or 0      -- into Left (x = 0 side of the part)
  local gR = j.side2 and g or 0      -- into Right
  local gB = j.bottom and g or 0
  local gT = j.lid and g or 0
  local xl = sp.x + t
  local xr = sp.x + options.width - t
  local yb = sp.y + j.z_bot
  local yt = sp.y + j.z_top

  local tablist = {}
  local contour = Contour(0.0)
  contour:AppendPoint(Point2D(xl, yb - gB))
  LineToIfNeeded(contour, Point2D(xr, yb - gB))
  AddMiddleOfLastSpanToList(contour, tablist)
  LineToIfNeeded(contour, Point2D(xr, yb))
  LineToIfNeeded(contour, Point2D(xr + gR, yb))
  LineToIfNeeded(contour, Point2D(xr + gR, yt))
  AddMiddleOfLastSpanToList(contour, tablist)
  LineToIfNeeded(contour, Point2D(xr, yt))
  LineToIfNeeded(contour, Point2D(xr, yt + gT))
  LineToIfNeeded(contour, Point2D(xl, yt + gT))
  AddMiddleOfLastSpanToList(contour, tablist)
  LineToIfNeeded(contour, Point2D(xl, yt))
  LineToIfNeeded(contour, Point2D(xl - gL, yt))
  LineToIfNeeded(contour, Point2D(xl - gL, yb))
  AddMiddleOfLastSpanToList(contour, tablist)
  LineToIfNeeded(contour, Point2D(xl, yb))
  LineToIfNeeded(contour, Point2D(xl, yb - gB))

  return Face(contour, nil, {}, tablist, "Divider" .. index, FaceType.Divider, FaceJointType.Fingers, {}, nil)
end

--[[  -------------- MakeDividerFace --------------------------------------------------
|
|  One divider: the inside width (Left to Right inside faces) by z_bot..z_top,
|  with through fingers into each neighbour DividerJoints says to joint into.
|  Drawn anti-clockwise, Left at x = 0, y = z.
|
]]
function MakeDividerFace(options, facesToMake, index)
  if DividerUsesGrooves(options) then
    return MakeGroovedDividerFace(options, facesToMake, index)   -- by Claude 11/26/2026
  end
  local t = options.thickness
  local sp = options.start_point
  local j = DividerJoints(options, facesToMake)
  local fw = DividerFingerWidths(options)

  local x0 = sp.x + t
  local x1 = sp.x + options.width - t
  local y0 = sp.y + j.z_bot
  local y1 = sp.y + j.z_top
  local inner_w = x1 - x0
  local inner_h = y1 - y0
  local side_spans = DividerFingerSpans(inner_h, fw.side)
  local none = {}

  local tablist = {}
  local fingerSides = ContourGroup(true)
  local contour = Contour(0.0)
  contour:AppendPoint(Point2D(x0, y0))
  -- bottom edge, left to right: fingers down through the bottom panel
  DrawDividerEdge(contour, Point2D(x0, y0), unit_x, -unit_y, inner_w,
    j.bottom and DividerFingerSpans(inner_w, fw.bottom) or none, t, tablist, fingerSides)
  -- right edge, upwards: fingers through Right (Side 2)
  DrawDividerEdge(contour, Point2D(x1, y0), unit_y, unit_x, inner_h,
    j.side2 and side_spans or none, t, tablist, fingerSides)
  -- top edge, right to left: fingers up through the lid
  DrawDividerEdge(contour, Point2D(x1, y1), -unit_x, unit_y, inner_w,
    j.lid and DividerFingerSpans(inner_w, fw.lid) or none, t, tablist, fingerSides)
  -- left edge, downwards: fingers through Left (Side 1)
  DrawDividerEdge(contour, Point2D(x0, y1), -unit_y, -unit_x, inner_h,
    j.side1 and side_spans or none, t, tablist, fingerSides)

  return Face(contour, nil, {}, tablist, "Divider" .. index, FaceType.Divider, FaceJointType.Fingers, {}, fingerSides)
end

-- Height in the side wall's own drawing that matches box height z: the wall's
-- inside bottom corner (start + thickness) is where its own bottom edge sits,
-- which is z = bottom_thickness (see MakeSideFace).
local function SideWallBottomZ(options)
  local t = options.thickness
  local bt = options.bottomType
  if (bt == FaceJointType.None or bt == FaceJointType.Grooved) then
    return 0
  elseif (bt == FaceJointType.Inset) then
    return 0.5*t
  end
  return t
end

--[[  -------------- AddDividerSlotsToFaces --------------------------------------------------
|
|  Adds the through slots for every divider finger to the faces they pass
|  through, as face.slot_contours (the slot outlines at their true size; the
|  tool path is worked out at toolpath time). Must run while the faces are
|  still at their own origins, before they are laid out on the sheets.
|
|  Left wall: its x runs from Front (x = 0) to Back. Right wall: from Back to
|  Front (see MakeSideFace). Bottom: Front at y = 0. Lid: drawn inside face up,
|  so Front is at y = depth (see MakeInsetContours).
|
]]
function AddDividerSlotsToFaces(faces, options, facesToMake)
  local n = DividerCount(options)
  if n == 0 then
    return
  end
  local t = options.thickness            -- the walls / bottom / lid
  local td = DividerThickness(options)   -- the dividers: slot / groove width across the depth -- by Claude 11/27/2026
  local sp = options.start_point
  local positions = DividerPositions(options)
  local j = DividerJoints(options, facesToMake)
  local fw = DividerFingerWidths(options)
  local inner_w = options.width - 2*t
  local side_spans = DividerFingerSpans(j.z_top - j.z_bot, fw.side)
  local bottom_spans = DividerFingerSpans(inner_w, fw.bottom)
  local lid_spans = DividerFingerSpans(inner_w, fw.lid)
  local wall_bottom = SideWallBottomZ(options)

  -- Dividers set to Groove: grooves (pocketed half deep) instead of through slots,
  -- same faces and the same coordinates as the slots below.  -- by Claude 11/26/2026
  if DividerUsesGrooves(options) then
    local gw = DividerGrooveWidth(options)
    local half_play = 0.5*(gw - td)           -- the groove is centred on the divider
    local run = DividerGrooveRunOn(options)
    local function AddGroove(face, xa, ya, xb, yb)
      if face.divider_groove_contours == nil then
        face.divider_groove_contours = ContourGroup(true)
      end
      local c = Contour(0.0)
      c:AppendPoint(Point2D(xa, ya))
      c:LineTo(Point2D(xb, ya))
      c:LineTo(Point2D(xb, yb))
      c:LineTo(Point2D(xa, yb))
      c:LineTo(Point2D(xa, ya))
      face.divider_groove_contours:AddTail(c)
    end
    -- Left / Right: from the bottom of the divider (run on past it, but never
    -- below the wall) up to its top - or out through the top edge of an open box.
    -- With a Top inset the groove stops above the divider's top by the allowance
    -- (clearance), plus the same tool-radius run-on as the bottom end so the bit's
    -- round corners can't catch the divider's square top corners - instead of
    -- running on up the wall above a divider that no longer reaches it.
    --                                                         -- by Claude 11/26/2026
    local z0 = math.max(j.z_bot - run, 0)
    if j.z_bot < 0.0001 then z0 = -run end   -- no bottom: open at the bottom edge too
    local inset = tonumber(options.dividerInset) or 0
    local z1 = j.z_top + math.max(0, options.allowance or 0) + run
    if DividerGroovesOpenTop(options) and inset <= 0.0001 then z1 = options.height + run end
    for i = 1, #faces do
      local face = faces[i]
      if (face.facetype == FaceType.Side) then
        local is_side1 = (face.name == "SideFace1")
        if (is_side1 and j.side1) or ((not is_side1) and j.side2) then
          local ya = sp.y + t + (z0 - wall_bottom)
          local yb = sp.y + t + (z1 - wall_bottom)
          for k = 1, n do
            local xa = sp.x + positions[k] - half_play
            if not is_side1 then
              xa = sp.x + options.depth - positions[k] - td - half_play
            end
            AddGroove(face, xa, ya, xa + gw, yb)
          end
        end
      elseif (face.facetype == FaceType.Bottom and j.bottom) then
        for k = 1, n do
          local ya = sp.y + positions[k] - half_play
          AddGroove(face, sp.x + t - run, ya, sp.x + options.width - t + run, ya + gw)
        end
      elseif (face.facetype == FaceType.Lid and j.lid) then
        for k = 1, n do
          local ya = sp.y + options.depth - positions[k] - td - half_play
          AddGroove(face, sp.x + t - run, ya, sp.x + options.width - t + run, ya + gw)
        end
      end
    end
    return
  end

  local function AddSlot(face, xa, ya, xb, yb)
    if face.slot_contours == nil then
      face.slot_contours = ContourGroup(true)
    end
    local c = Contour(0.0)
    c:AppendPoint(Point2D(xa, ya))
    c:LineTo(Point2D(xb, ya))
    c:LineTo(Point2D(xb, yb))
    c:LineTo(Point2D(xa, yb))
    c:LineTo(Point2D(xa, ya))
    face.slot_contours:AddTail(c)
  end

  for i = 1, #faces do
    local face = faces[i]
    if (face.facetype == FaceType.Side) then
      local is_side1 = (face.name == "SideFace1")
      if (is_side1 and j.side1) or ((not is_side1) and j.side2) then
        for k = 1, n do
          local xa = sp.x + positions[k]
          if not is_side1 then
            xa = sp.x + options.depth - positions[k] - td
          end
          for s = 1, #side_spans do
            local ya = sp.y + t + (j.z_bot + side_spans[s][1] - wall_bottom)
            local yb = sp.y + t + (j.z_bot + side_spans[s][2] - wall_bottom)
            AddSlot(face, xa, ya, xa + td, yb)
          end
        end
      end
    elseif (face.facetype == FaceType.Bottom and j.bottom) then
      for k = 1, n do
        local ya = sp.y + positions[k]
        for s = 1, #bottom_spans do
          AddSlot(face, sp.x + t + bottom_spans[s][1], ya, sp.x + t + bottom_spans[s][2], ya + td)
        end
      end
    elseif (face.facetype == FaceType.Lid and j.lid) then
      for k = 1, n do
        local ya = sp.y + options.depth - positions[k] - td
        for s = 1, #lid_spans do
          AddSlot(face, sp.x + t + lid_spans[s][1], ya, sp.x + t + lid_spans[s][2], ya + td)
        end
      end
    end
  end
end

--[[  -------------- DividerSlotToolPath --------------------------------------------------
|
|  Tool centre path (cut "on" the line, like the cutout) for one rectangular
|  slot: the slot moved in by `radius` (tool radius minus allowance, so a
|  positive allowance makes the slot bigger = looser, the same way it makes
|  the parts smaller). With dogbones, each corner gets a relief so the tool
|  reaches right into it and the square finger fits; without, the corners stay
|  round like the box's own finger joints (the roundover tool handles the
|  fingers then). Clockwise, as the inside of a hole. nil if the slot is too
|  small for the tool.
|
]]
function DividerSlotToolPath(slot, radius, dogbones)
  local b = slot.BoundingBox2D
  local x0, y0, x1, y1 = b.MinX + radius, b.MinY + radius, b.MaxX - radius, b.MaxY - radius
  if (x1 - x0 < 0.0001 or y1 - y0 < 0.0001) then
    return nil
  end
  local relief = radius - radius / math.sqrt(2)   -- from the corner of the path towards the slot corner
  local corners = {
    { x0, y0, -1, -1 },   -- clockwise from lower left: up the left side first
    { x0, y1, -1,  1 },
    { x1, y1,  1,  1 },
    { x1, y0,  1, -1 }
  }
  local path = Contour(0.0)
  for i = 1, #corners do
    local c = corners[i]
    if i == 1 then
      path:AppendPoint(Point2D(c[1], c[2]))
    else
      path:LineTo(Point2D(c[1], c[2]))
    end
    if dogbones and relief > 0.000001 then
      path:LineTo(Point2D(c[1] + c[3]*relief, c[2] + c[4]*relief))
      path:LineTo(Point2D(c[1], c[2]))
    end
  end
  path:LineTo(Point2D(x0, y0))
  return path
end

