-- VECTRIC LUA SCRIPT
-- DisplayDialog.xlua
--
-- The options dialog: building the HTML_Dialog and its geometry-validation
-- rules, reading its fields back into the options table, and the registry
-- persistence (save/load) that remembers the user's settings between runs.

local G_decimalPlaces = 3  --- Number of decimal places to show in the UI for joint widths and other geometry values

-- Set by DisplayDialog() when the dialog opens. OnLuaButton_* callbacks below
-- are called by Vectric by name (it looks up "OnLuaButton_<id>" globally), so
-- they can't close over DisplayDialog()'s local "options" - this lets them
-- reach the same live options table instead.
local G_dialogOptions

-- Validates the box width/depth/height against the minimum required by the
-- material thickness (each must exceed twice the thickness, since the box
-- wall is cut from it on both sides).
--
-- report_as_dialog = true (the OK/Validate flow): stops at the first invalid
-- dimension and pops a DisplayMessageBox describing it - the original inline
-- behavior this was extracted from.
-- report_as_dialog = false (the live DimensionsChanged callback): checks all
-- three and instead silently writes the problem (or "" when valid) into each
-- one's own Invalid text field, so the HTML side can mark that field red and
-- show the message as its tooltip.
--
-- Returns true if width, depth and height are all valid.
local function ValidateBoxDimensions(dialog, options, report_as_dialog)
  local double_thickness = options.thickness * 2
  local dims = {
    { value = options.width,  label = "width",  invalid_field = "InvalidWidth" },
    { value = options.depth,  label = "depth",  invalid_field = "InvalidDepth" },
    { value = options.height, label = "height", invalid_field = "InvalidHeight" },
  }

  local all_ok = true
  for _, dim in ipairs(dims) do
    local is_invalid = dim.value <= double_thickness
    local message = ""
    if is_invalid then
      all_ok = false
      message = string.format("The box %s %." .. G_decimalPlaces .. "f is too small for material thickness %." .. G_decimalPlaces .. "f.", dim.label, dim.value, options.thickness)
    end

    if report_as_dialog then
      if is_invalid then
        DisplayMessageBox(message)
        return false
      end
    else
      dialog:UpdateTextField(dim.invalid_field, message)
    end
  end

  return all_ok
end

-- Also set by DisplayDialog() when the dialog opens, for the same reason as
-- G_dialogOptions above.
local G_dialogSideDoveTail
local G_dialogBottomDoveTail
local G_dialogLidDoveTail

-- Helpers for the geometry-validation messages below: given the inner
-- dimension(s) a joint width has to divide into, suggest a width that
-- would actually work, so the error message tells the user what to try
-- instead of just what's wrong.

-- Largest width that still fits at least one flap across every given
-- inner dimension (used when the current width is too big).
local function SuggestSmallerJointWidth(inner_dims)
  local max_width = math.huge
  for _, inner_dim in ipairs(inner_dims) do
    max_width = math.min(max_width, 0.5 * inner_dim)
  end
  return Truncate(math.max(max_width - 0.001, 0), G_decimalPlaces)
end

-- Whether joint width w leaves at least required_space of clearance across
-- every given inner dimension, using the same formula the validator itself
-- uses below, so suggestions are guaranteed self-consistent.
local function JointWidthFits(w, inner_dims, required_space)
  for _, inner_dim in ipairs(inner_dims) do
    local num_flaps = math.floor(0.5 * inner_dim / w)
    if num_flaps < 1 then
      return false
    end
    local tab_space = (inner_dim - num_flaps * w) / (num_flaps + 1)
    if tab_space <= required_space then
      return false
    end
  end
  return true
end

-- Width nearest to current_width (searching outward in both directions at
-- once) that leaves at least required_space of clearance across every given
-- inner dimension. For a fixed flap count, clearance only shrinks as the
-- width grows - it takes a *smaller* width to drop to fewer, thinner flaps
-- and free up more open gap - so a joint that's too tight can sometimes
-- only be fixed by going smaller, not larger. Both directions are tried and
-- whichever gets there first (i.e. numerically closest to current_width)
-- wins, so the search actually finds a fix when one exists either way.
-- Returns the suggested width and "larger"/"smaller", or nil, nil if
-- nothing within the search range works in either direction.
--
-- The value we hand back is always truncated to g_decimalPlaces decimals for display, so
-- we must verify THAT truncated value with JointWidthFits rather than the
-- raw stepped width - tab_space is not monotonic across flap-count
-- boundaries (see above), so truncating a verified-good raw width can push
-- it back into a non-fitting bracket. Checking the truncated value directly
-- guarantees the number actually shown to the user really works.
local function SuggestWorkingJointWidth(options, current_width, inner_dims, required_space)
  local step = options.InMM and 0.1 or 0.005
  local tick = 10 ^ (-G_decimalPlaces)
  local max_search_width = 0
  for _, inner_dim in ipairs(inner_dims) do
    max_search_width = math.max(max_search_width, inner_dim)
  end
  max_search_width = 2 * max_search_width

  -- Candidate widths to try, collected up front so the closest one that
  -- actually works can be picked regardless of which kind of candidate
  -- found it. Two kinds:
  --
  -- 1) Flap-count-boundary candidates: for every given inner dimension,
  --    for every flap count from one less than the current count down to
  --    1, the width just above that bracket's lower bound - i.e. the
  --    width that gets the most tab_space out of that many, wider tails.
  --    Reducing the flap count is usually what actually fixes a too-tight
  --    joint (tab_space jumps, not just shrinks, at a boundary - see the
  --    header comment above), and a uniform step below can step clean
  --    over a bracket narrower than the step size without ever landing a
  --    test width inside it, so these are tried explicitly rather than
  --    left to chance.
  -- 2) A uniform fine-grained sweep outward in both directions, exactly
  --    as before, as a general-purpose fallback for widths that aren't
  --    at a flap-count boundary.
  local candidates = {}

  for _, inner_dim in ipairs(inner_dims) do
    local current_flaps = math.floor(0.5 * inner_dim / current_width)
    for k = math.max(current_flaps - 1, 1), 1, -1 do
      local lower_bound = inner_dim / (2 * (k + 1))
      -- Truncate rounds toward zero, which could land exactly on (or
      -- below) lower_bound and so fall back into the k+1 bracket; adding
      -- one tick guarantees the candidate stays strictly inside bracket k.
      candidates[#candidates + 1] = Truncate(lower_bound, G_decimalPlaces) + tick
    end
  end

  local steps_up = math.floor((max_search_width - current_width) / step)
  local steps_down = math.floor((current_width - step) / step)
  local fine_steps = math.max(steps_up, steps_down)
  for i = 1, fine_steps do
    if i <= steps_up then
      candidates[#candidates + 1] = Truncate(current_width + i * step, G_decimalPlaces)
    end
    if i <= steps_down then
      candidates[#candidates + 1] = Truncate(current_width - i * step, G_decimalPlaces)
    end
  end

  -- Pick the candidate closest to current_width that actually works,
  -- ties going to the larger one (matching the historical up-before-down
  -- preference of the old step loop this replaced).
  local best_w, best_dist
  for _, w in ipairs(candidates) do
    if w > 0 and JointWidthFits(w, inner_dims, required_space) then
      local dist = math.abs(w - current_width)
      if not best_dist or dist < best_dist or (dist == best_dist and w > best_w) then
        best_w, best_dist = w, dist
      end
    end
  end

  if not best_w then
    return nil, nil
  end
  return best_w, (best_w > current_width) and "larger" or "smaller"
end

-- Dovetail-only alternative to SuggestWorkingJointWidth: given the CURRENT
-- joint width (so the tail count/layout doesn't change at all), suggest a
-- steeper dovetail angle that would give the same joint enough clearance
-- for the bit instead. sideDoveTail/bottomDoveTail/lidDoveTail all share
-- one angle (see ReadOptionsFromDialog), so a *steeper* angle is the only
-- direction worth suggesting: it strictly shrinks min_space
-- (2*thickness/tan(angle)) for every dovetail type at once, so it can
-- only help the other two joints, never break one that was already fine.
-- Returns the suggested angle in degrees, or nil if no angle within the
-- allowed 45-85 range would be enough (the joint width has to change
-- instead).
local function SuggestSteeperAngle(current_width, inner_dims, thickness, effectiveDia, toolpath_safety_clearance)
  local tightest_tab_space = math.huge
  for _, inner_dim in ipairs(inner_dims) do
    local num_flaps = math.floor(0.5 * inner_dim / current_width)
    if num_flaps < 1 then
      return nil -- current width doesn't even lay out a flap; not this function's problem
    end
    local tab_space = (inner_dim - num_flaps * current_width) / (num_flaps + 1)
    tightest_tab_space = math.min(tightest_tab_space, tab_space)
  end

  -- margin is how much min_space (the dovetail's own base-to-tip
  -- widening) would need to shrink by before the bit and safety
  -- clearance fit in the remaining gap too.
  local margin = tightest_tab_space - effectiveDia - toolpath_safety_clearance
  if margin <= 0 then
    return nil -- no angle helps - the bit itself doesn't fit in the gap at this width
  end

  local required_angle_deg = math.deg(math.atan(2 * thickness / margin))

  -- Round up to a tenth of a degree (what the field will actually show),
  -- then re-verify - same reasoning as SuggestWorkingJointWidth: the
  -- rounded value is what the user will actually enter, so that's what
  -- has to be checked, not the unrounded one.
  local suggested = math.ceil(required_angle_deg * 10) / 10
  if 2 * thickness / math.tan(math.rad(suggested)) >= margin then
    suggested = suggested + 0.1
  end

  if suggested > 85 then
    return nil -- steeper than the allowed range; the joint width has to change instead
  end

  return suggested
end

-- The best (largest) worst-case tab_space achievable across every given
-- inner dimension, and the joint width that achieves it - searched by
-- sweeping every width in a sane range, independent of angle or bit size.
-- Used only once neither a width change nor an angle change (nor both
-- together) can fix things: it answers "is any width workable at all,
-- and how much room does the best one leave," so that can be checked
-- against what a smaller bit would need.
local function BestAchievableTabSpace(options, inner_dims)
  local step = options.InMM and 0.02 or 0.001
  local max_search_width = 0
  for _, inner_dim in ipairs(inner_dims) do
    max_search_width = math.max(max_search_width, inner_dim)
  end
  local steps = math.floor(max_search_width / step)

  local best_w, best_tab_space
  for i = 1, steps do
    local w = i * step
    local worst_tab_space = math.huge
    local valid = true
    for _, inner_dim in ipairs(inner_dims) do
      local num_flaps = math.floor(0.5 * inner_dim / w)
      if num_flaps < 1 then
        valid = false
        break
      end
      local tab_space = (inner_dim - num_flaps * w) / (num_flaps + 1)
      if tab_space < worst_tab_space then
        worst_tab_space = tab_space
      end
    end
    if valid and (not best_tab_space or worst_tab_space > best_tab_space) then
      best_w, best_tab_space = Truncate(w, G_decimalPlaces), worst_tab_space
    end
  end

  return best_w, best_tab_space
end

-- Builds the full suggestion text for a dovetail "won't fit" message,
-- trying progressively larger changes until something actually works:
--   1. a different joint width, at the CURRENT angle
--   2. a steeper angle, at the CURRENT joint width
--   3. a joint width AND a steeper angle together, if neither alone is
--      enough - searching for a width that works once the angle is
--      pushed all the way to the 85 degree cap, then reporting the
--      actual (possibly less extreme) angle that specific width needs
--   4. if not even that combination works, the largest bit diameter that
--      WOULD fit, with the best achievable joint width and the 85 degree
--      cap - i.e. "you'd need a smaller bit"
-- Returns the suggestion text (with a leading space, ready to append), or
-- "" if nothing at all was found to suggest.
local function BuildDovetailFitSuggestion(options, current_width, inner_dims, effectiveDia, toolpath_safety_clearance, required_space)
  local suggested, direction = SuggestWorkingJointWidth(options, current_width, inner_dims, required_space)
  if suggested then
    return string.format(" Try a joint width of %." .. G_decimalPlaces .. "f or %s.", suggested, direction)
  end

  local steeper_angle = SuggestSteeperAngle(current_width, inner_dims, options.thickness, effectiveDia, toolpath_safety_clearance)
  if steeper_angle then
    return string.format(" Keep the current joint width and use a dovetail angle of %.1f\194\176 or steeper.", steeper_angle)
  end

  -- Neither alone works - see if width and angle together do, using the
  -- steepest allowed angle (85 degrees) to find the most forgiving
  -- possible required_space, then reporting the actual angle that width
  -- needs (which may be less extreme than 85).
  local max_angle_min_space = 2 * options.thickness / math.tan(math.rad(85))
  local loosest_required_space = max_angle_min_space + effectiveDia + toolpath_safety_clearance
  local combined_width = SuggestWorkingJointWidth(options, current_width, inner_dims, loosest_required_space)
  if combined_width then
    local needed_angle = SuggestSteeperAngle(combined_width, inner_dims, options.thickness, effectiveDia, toolpath_safety_clearance) or 85
    return string.format(
      " Try a joint width of %." .. G_decimalPlaces .. "f together with a dovetail angle of %.1f\194\176 or steeper.",
      combined_width, needed_angle)
  end

  -- Not even the best possible width and the steepest allowed angle are
  -- enough - the bit itself is the limiting factor. Find the largest bit
  -- diameter that would fit, given the best achievable joint width and
  -- the steepest allowed angle.
  local best_width, best_tab_space = BestAchievableTabSpace(options, inner_dims)
  if best_width and best_tab_space then
    local max_effective_dia = best_tab_space - max_angle_min_space - toolpath_safety_clearance
    if max_effective_dia > 0 then
      local max_bit_dia = max_effective_dia + 2 * options.allowance
      return string.format(
        " No joint width or dovetail angle (up to 85\194\176) will let this bit fit here - try a bit %." .. G_decimalPlaces .. "f or smaller instead (with a joint width around %." .. G_decimalPlaces .. "f and a dovetail angle of 85\194\176 or steeper).",
        max_bit_dia, best_width)
    end
  end

  return ""
end

-- Validates the dovetail angle field (only meaningful for dovetail joints -
-- mirrors HTML/JS visibility). Must be between 45 and 85 degrees.
--
-- report_as_dialog = true: pops a DisplayMessageBox and returns false when
-- invalid - the original inline behavior this was extracted from.
-- report_as_dialog = false: silently writes the problem (or "" when valid)
-- into InvalidDovetailAngle instead.
local function ValidateDovetailAngle(dialog, options, report_as_dialog)
  if not options.dovetailJoint then
    if not report_as_dialog then
      dialog:UpdateTextField("InvalidDovetailAngle", "")
    end
    return true
  end

  local is_invalid = not IsNonNeg(options.dovetailAngleDegrees) or options.dovetailAngleDegrees < 45 or options.dovetailAngleDegrees > 85
  local message = is_invalid and "Dovetail angle must be between 45 and 85 degrees." or ""

  if report_as_dialog then
    if is_invalid then
      DisplayMessageBox(message)
      return false
    end
    return true
  end

  dialog:UpdateTextField("InvalidDovetailAngle", message)
  return not is_invalid
end

-- Validates the Side/Bottom/Lid joint widths: first that they geometrically
-- fit within the box's own inner dimensions, then - if the allowance leaves
-- a usable effective tool diameter - that the cutting tool actually fits in
-- the resulting gap, for whichever joint type (finger/box vs dovetail) is
-- currently selected. Also validates the allowance itself (InvalidAllowance)
-- as a side effect, since it's this same effective-diameter computation that
-- decides whether it's too large for the tool. Relies on
-- SuggestSmallerJointWidth, SuggestWorkingJointWidth, and
-- BuildDovetailFitSuggestion, which DisplayDialog() (re)defines as globals
-- each time the dialog opens - see the comment there.
--
-- report_as_dialog = true (OK/Validate flow): stops at the first problem and
-- pops the matching DisplayMessageBox with a suggested fix - the original
-- inline behavior this was extracted from, unchanged.
-- report_as_dialog = false (live DimensionsChanged callback): checks
-- everything and instead writes the problem (or "" when valid) into whichever
-- field's Invalid text field is actually responsible - only the FIRST problem
-- found for a given joint is kept, matching the OK/Validate flow, which also
-- only ever reports the first one. When "use all joint widths" is off,
-- Bottom and Lid share the single visible Side/All joint width field (see
-- ReadOptionsFromDialog), so a failure in either of them is reported against
-- InvalidSideJointWidth instead - flagging their own fields would mark a
-- hidden field.
--
-- Returns true if every joint currently being cut is valid.
local function ValidateJointWidths(dialog, options, sideDoveTail, bottomDoveTail, lidDoveTail, report_as_dialog)
  local double_thickness = options.thickness * 2
  local inner_width = options.width - double_thickness
  local inner_depth = options.depth - double_thickness
  -- "Side Overhang" (independent End 1/End 2 heights) and a Grooved bottom
  -- (which reserves less height above End 2's own corner than a normal
  -- bottom) can each make one end's usable corner height smaller than the
  -- other's; validate against whichever corner is actually smaller. When
  -- neither feature is in use, end1Height/end2Height both equal options.height
  -- and bottomGrooveOffset is unused, so this reduces to the original formula.
  -- (merged in from the Grooved-variabel fork)
  local top_reserved_for_corner = ThicknessForFaceType(options.lidType, options.thickness)
  local bottom_thickness_end1 = ThicknessForFaceType(options.bottomType, options.thickness)
  local bottom_thickness_end2 = bottom_thickness_end1
  if (options.bottomType == FaceJointType.Grooved) then
    bottom_thickness_end2 = options.bottomGrooveOffset or 0
  end
  local inner_height = math.min(
    (options.end1Height or options.height) - top_reserved_for_corner - bottom_thickness_end1,
    (options.end2Height or options.height) - top_reserved_for_corner - bottom_thickness_end2)

  local cuttingBottomJoint = (options.bottomType == FaceJointType.Fingers) and
    (options.facesToMake.bottom or options.create_tabs_for_missing_faces)
  local cuttingLidJoint = (options.lidType == FaceJointType.Fingers) and
    (options.facesToMake.lid or options.create_tabs_for_missing_faces)

  local num_flaps_w_bottom = math.floor((0.5*inner_width) / bottomDoveTail.min_width)
  local total_tab_space_w_bottom = (inner_width - num_flaps_w_bottom*bottomDoveTail.min_width)
  local num_flaps_d_bottom = math.floor((0.5*inner_depth) / bottomDoveTail.min_width)
  local total_tab_space_d_bottom = (inner_depth - num_flaps_d_bottom*bottomDoveTail.min_width)

  local num_flaps_w_lid = math.floor((0.5*inner_width) / lidDoveTail.min_width)
  local total_tab_space_w_lid = (inner_width - num_flaps_w_lid*lidDoveTail.min_width)
  local num_flaps_d_lid = math.floor((0.5*inner_depth) / lidDoveTail.min_width)
  local total_tab_space_d_lid = (inner_depth - num_flaps_d_lid*lidDoveTail.min_width)

  local num_flaps_h = math.floor((0.5*inner_height) / sideDoveTail.min_width)
  local total_tab_space_h = (inner_height - num_flaps_h*sideDoveTail.min_width)

  local bottom_message, lid_message, side_message = "", "", ""

  -- Handles one problem found for a joint: in report_as_dialog mode, pops
  -- the message box and returns true (meaning "stop now, return false") -
  -- the original behavior. Otherwise returns the message to keep for that
  -- joint (the earlier of current_message/new_message, so only the first
  -- problem found survives) and false (meaning "keep going").
  local function report(current_message, new_message)
    if report_as_dialog then
      DisplayMessageBox(new_message)
      return current_message, true
    end
    if current_message == "" then
      return new_message, false
    end
    return current_message, false
  end

  if cuttingBottomJoint then
    if (num_flaps_w_bottom < 1) or (total_tab_space_w_bottom < 0) then
      local suggested = SuggestSmallerJointWidth({inner_width, inner_depth})
      local suggestion_text = string.format(" Try a joint width of %." .. G_decimalPlaces .. "f or smaller.", suggested)
      local message
      if (not options.useAllJointWidths) then
        message = string.format("The joint width %." .. G_decimalPlaces .. "f is too big given boxes bottom given the inner width is %." .. G_decimalPlaces .. "f.%s", bottomDoveTail.min_width, inner_width, suggestion_text)
      else
        message = string.format("The bottom joint width %." .. G_decimalPlaces .. "f is too big given box inner width is %." .. G_decimalPlaces .. "f.%s", bottomDoveTail.min_width, inner_width, suggestion_text)
      end
      local aborted
      bottom_message, aborted = report(bottom_message, message)
      if aborted then return false end
    end

    if (num_flaps_d_bottom < 1) or (total_tab_space_d_bottom < 0) then
      local suggested = SuggestSmallerJointWidth({inner_width, inner_depth})
      local suggestion_text = string.format(" Try a joint width of %." .. G_decimalPlaces .. "f or smaller.", suggested)
      local message
      if (not options.useAllJointWidths) then
        message = string.format("The joint width %." .. G_decimalPlaces .. "f is too big given boxes bottom given the inner depth is %." .. G_decimalPlaces .. "f.%s", bottomDoveTail.min_width, inner_depth, suggestion_text)
      else
        message = string.format("The bottom joint width %." .. G_decimalPlaces .. "f is too big given box inner depth is %." .. G_decimalPlaces .. "f.%s", bottomDoveTail.min_width, inner_depth, suggestion_text)
      end
      local aborted
      bottom_message, aborted = report(bottom_message, message)
      if aborted then return false end
    end
  end

  if cuttingLidJoint then
    if (num_flaps_w_lid < 1) or (total_tab_space_w_lid < 0) then
      local suggested = SuggestSmallerJointWidth({inner_width, inner_depth})
      local message = string.format("The lid joint width %." .. G_decimalPlaces .. "f is too big given box inner width is %." .. G_decimalPlaces .. "f. Try a joint width of %." .. G_decimalPlaces .. "f or smaller.", lidDoveTail.min_width, inner_width, suggested)
      local aborted
      lid_message, aborted = report(lid_message, message)
      if aborted then return false end
    end
    if (num_flaps_d_lid < 1) or (total_tab_space_d_lid < 0) then
      local suggested = SuggestSmallerJointWidth({inner_width, inner_depth})
      local message = string.format("The lid joint width %." .. G_decimalPlaces .. "f is too big given box inner depth is %." .. G_decimalPlaces .. "f. Try a joint width of %." .. G_decimalPlaces .. "f or smaller.", lidDoveTail.min_width, inner_depth, suggested)
      local aborted
      lid_message, aborted = report(lid_message, message)
      if aborted then return false end
    end
  end

  if (num_flaps_h < 1) or (total_tab_space_h < 0) then
    local suggested = SuggestSmallerJointWidth({inner_height})
    local message = string.format("The side joint width %." .. G_decimalPlaces .. "f is too big given box inner height is %." .. G_decimalPlaces .. "f. Try a joint width of %." .. G_decimalPlaces .. "f or smaller.", sideDoveTail.min_width, inner_height, suggested)
    local aborted
    side_message, aborted = report(side_message, message)
    if aborted then return false end
  end

  -- Check if tool will fit
  local mtl_block = MaterialBlock()
  local converted_tool_diameter = 0.25
  if Tool_ok(options.tool) then
    converted_tool_diameter = ConvertUnitsFrom(options.tool.ToolDia, options.tool, mtl_block)
  end

  local effectiveDia = converted_tool_diameter
  if options.allowance > 0 then
    effectiveDia = effectiveDia - 2 * options.allowance
  end

  local can_check_tool_fit = effectiveDia > 0
  local allowance_message = ""
  if not can_check_tool_fit then
    allowance_message = string.format("The allowance is too large given the tool diameter.\n\nThe allowance must be less than half the tool diameter (%." .. G_decimalPlaces .. "f).", converted_tool_diameter / 2)
    if report_as_dialog then
      DisplayMessageBox(allowance_message)
      return false
    end
  end

  if not report_as_dialog then
    dialog:UpdateTextField("InvalidAllowance", allowance_message)
  end

  if can_check_tool_fit then
    local tab_space_w_bottom = total_tab_space_w_bottom / (num_flaps_w_bottom + 1)
    local tab_space_d_bottom = total_tab_space_d_bottom / (num_flaps_d_bottom + 1)
    local tab_space_w_lid = total_tab_space_w_lid / (num_flaps_w_lid + 1)
    local tab_space_d_lid = total_tab_space_d_lid / (num_flaps_d_lid + 1)
    local tab_space_h = total_tab_space_h / (num_flaps_h + 1)

    if options.dovetailJoint then
      local min_space = sideDoveTail.max_width - sideDoveTail.min_width
      local bottom_min_space = bottomDoveTail.max_width - bottomDoveTail.min_width
      local top_min_space = lidDoveTail.max_width - lidDoveTail.min_width

      local toolpath_safety_clearance = options.InMM and 0.254 or 0.010
      local required_side_space = min_space + effectiveDia + toolpath_safety_clearance
      local required_bottom_space = bottom_min_space + effectiveDia + toolpath_safety_clearance
      local required_lid_space = top_min_space + effectiveDia + toolpath_safety_clearance

      if (tab_space_h <= required_side_space) then
        local suggestion_text = BuildDovetailFitSuggestion(options, sideDoveTail.min_width, {inner_height}, effectiveDia, toolpath_safety_clearance, required_side_space)
        local message = "The selected tool will not fit between the side joints." .. suggestion_text
        local aborted
        side_message, aborted = report(side_message, message)
        if aborted then return false end
      end
      if cuttingBottomJoint and
         ((tab_space_w_bottom <= required_bottom_space) or
          (tab_space_d_bottom <= required_bottom_space)) then
        local suggestion_text = BuildDovetailFitSuggestion(options, bottomDoveTail.min_width, {inner_width, inner_depth}, effectiveDia, toolpath_safety_clearance, required_bottom_space)
        local message = "The selected tool will not fit between the bottom joints." .. suggestion_text
        local aborted
        bottom_message, aborted = report(bottom_message, message)
        if aborted then return false end
      end
      if cuttingLidJoint and
         ((tab_space_w_lid <= required_lid_space) or
          (tab_space_d_lid <= required_lid_space)) then
        local suggestion_text = BuildDovetailFitSuggestion(options, lidDoveTail.min_width, {inner_width, inner_depth}, effectiveDia, toolpath_safety_clearance, required_lid_space)
        local message = "The selected tool will not fit between the lid joints." .. suggestion_text
        local aborted
        lid_message, aborted = report(lid_message, message)
        if aborted then return false end
      end
    else
      tab_space_w_bottom = math.min(tab_space_w_bottom, bottomDoveTail.min_width)
      tab_space_d_bottom = math.min(tab_space_d_bottom, bottomDoveTail.min_width)
      tab_space_w_lid = math.min(tab_space_w_lid, lidDoveTail.min_width)
      tab_space_d_lid = math.min(tab_space_d_lid, lidDoveTail.min_width)
      tab_space_h = math.min(tab_space_h, sideDoveTail.min_width)

      if cuttingBottomJoint and ((tab_space_w_bottom <= effectiveDia) or (tab_space_d_bottom <= effectiveDia)) then
        local suggested, direction = SuggestWorkingJointWidth(options, bottomDoveTail.min_width, {inner_width, inner_depth}, effectiveDia)
        local suggestion_text = suggested and string.format(" Try a joint width of %." .. G_decimalPlaces .. "f or %s.", suggested, direction) or ""
        local message = "The selected tool will not fit between the bottom joints." .. suggestion_text
        local aborted
        bottom_message, aborted = report(bottom_message, message)
        if aborted then return false end
      end
      if (tab_space_h <= effectiveDia) then
        local suggested, direction = SuggestWorkingJointWidth(options, sideDoveTail.min_width, {inner_height}, effectiveDia)
        local suggestion_text = suggested and string.format(" Try a joint width of %." .. G_decimalPlaces .. "f or %s.", suggested, direction) or ""
        local message = "The selected tool will not fit between the side joints." .. suggestion_text
        local aborted
        side_message, aborted = report(side_message, message)
        if aborted then return false end
      end
      if options.useAllJointWidths and cuttingLidJoint then
        if (tab_space_w_lid <= effectiveDia) or (tab_space_d_lid <= effectiveDia) then
          local suggested, direction = SuggestWorkingJointWidth(options, lidDoveTail.min_width, {inner_width, inner_depth}, effectiveDia)
          local suggestion_text = suggested and string.format(" Try a joint width of %." .. G_decimalPlaces .. "f or %s.", suggested, direction) or ""
          local message = "The selected tool will not fit between the lid joints." .. suggestion_text
          local aborted
          lid_message, aborted = report(lid_message, message)
          if aborted then return false end
        end
      end
    end
  end

  if report_as_dialog then
    return true
  end

  -- When "use all joint widths" is off, Bottom and Lid share the single
  -- visible Side/All joint width field (see ReadOptionsFromDialog), so fold
  -- their messages into InvalidSideJointWidth instead of their own (hidden)
  -- fields.
  local side_field_message = side_message
  local bottom_field_message = bottom_message
  local lid_field_message = lid_message
  if not options.useAllJointWidths then
    side_field_message = side_message
    if side_field_message == "" then side_field_message = bottom_message end
    if side_field_message == "" then side_field_message = lid_message end
    bottom_field_message = ""
    lid_field_message = ""
  end

  dialog:UpdateTextField("InvalidSideJointWidth", side_field_message)
  dialog:UpdateTextField("InvalidBottomJointWidth", bottom_field_message)
  dialog:UpdateTextField("InvalidLidJointWidth", lid_field_message)

  return bottom_message == "" and lid_message == "" and side_message == "" and allowance_message == ""
end

-- Gremlin added bottomDoveTail seperation from side which is just sideDoveTail
function DisplayDialog(script_path, options, sideDoveTail, bottomDoveTail, lidDoveTail)
  G_dialogOptions = options
  G_dialogSideDoveTail = sideDoveTail
  G_dialogBottomDoveTail = bottomDoveTail
  G_dialogLidDoveTail = lidDoveTail

  local html_path = "file:" .. script_path .. "\\" .. G_htmlFile
  local dialog = HTML_Dialog(false, html_path, options.window_width, options.window_height, string.format("%s - Version %s %s", G_title, G_version, G_subVersion))

  dialog:AddLabelField("GadgetTitle", G_title)
  dialog:AddLabelField("GadgetVersion", G_version)

  -- Add Geometry fields
  dialog:AddDoubleField("WidthField", options.width)
  dialog:AddDoubleField("DepthField", options.depth)
  dialog:AddDoubleField("HeightField", options.height)
  dialog:AddDoubleField("DovetailAngleField", options.dovetailAngleDegrees)
  dialog:AddDoubleField("SideTabWidthField", options.sideOrAllTabWidth)
  dialog:AddDoubleField("BottomTabWidthField", options.bottomTabWidth)
  dialog:AddDoubleField("TopTabWidthField", options.lidTabWidth)
  dialog:AddCheckBox("AllJointWidths", options.useAllJointWidths)

  dialog:AddDoubleField("AllowanceField", options.allowance)
  dialog:AddDoubleField("PartSpacingField", options.partSpacing)
  dialog:AddDoubleField("ClampingMargin", options.clampingMargin)

  dialog:AddCheckBox("DarkMode", options.dark_mode)
  dialog:AddCheckBox("LabelFaces", options.label_faces)

  dialog:AddDropDownList("ZoomLevel", options.ZoomLevel)

  dialog:AddCheckBox("MakeLid", options.facesToMake.lid)
  dialog:AddCheckBox("MakeBottom", options.facesToMake.bottom)
  dialog:AddCheckBox("MakeSide1", options.facesToMake.side1)
  dialog:AddCheckBox("MakeSide2", options.facesToMake.side2)
  dialog:AddCheckBox("MakeEnd1", options.facesToMake.end1)
  dialog:AddCheckBox("MakeEnd2", options.facesToMake.end2)
  dialog:AddCheckBox("CreateTabsForMissingFaces", options.create_tabs_for_missing_faces)

  -- Fields that are hidden in the HTML but still read by Lua
  -- these are used to communicate back to us when things happen
  -- or for us to set things in the dialog that lua doesn't
  -- otherwise allow
  dialog:AddCheckBox("DimensionsChanged", false)
  dialog:AddTextField("InvalidWidth", "")
  dialog:AddTextField("InvalidDepth", "")
  dialog:AddTextField("InvalidHeight", "")
  dialog:AddTextField("InvalidSideJointWidth", "")
  dialog:AddTextField("InvalidLidJointWidth", "")
  dialog:AddTextField("InvalidBottomJointWidth", "")
  dialog:AddTextField("InvalidDovetailAngle", "")
  dialog:AddTextField("InvalidAllowance", "")

  -- Add Tool picker
  -- Add toolpath name field
  dialog:AddLabelField("ToolNameField", "")
  dialog:AddToolPicker("ToolChooseButton", "ToolNameField", options.default_toolid)
  dialog:AddToolPickerValidToolType("ToolChooseButton", Tool.END_MILL)
  dialog:AddCheckBox("NoToolpath", options.no_toolpath)
  dialog:AddCheckBox("CreateDogbones", options.create_dogbones)
  dialog:AddCheckBox("UseSingleSheet", options.useSingleSheet)
  dialog:AddDropDownList("PartLayoutSelect", options.partLayout)

  -- Roundover tool picker (only used for box joints with no dogbones, see HTML/JS visibility)
  dialog:AddLabelField("RoundoverToolNameField", "")
  dialog:AddToolPicker("RoundoverToolChooseButton", "RoundoverToolNameField", options.roundover_default_toolid)
  dialog:AddToolPickerValidToolType("RoundoverToolChooseButton", Tool.FORM_TOOL)
  dialog:AddDoubleField("RoundoverCutDepthField", options.roundover_cut_depth)

-- Tab Type: 1 = Finger Joint, 2 = Dovetail Joint
  local tab_default_index
  if options.dovetailJoint then
    tab_default_index = 2  -- last time user chose dovetails
  else
    tab_default_index = 1  -- last time user chose finger joints
  end

  dialog:AddRadioGroup("TabTypeRadio", tab_default_index)

  local topString = FaceJointTypeToString(options.lidType)
  dialog:AddDropDownList("LidTypeSelect", topString)

  local bottomString = FaceJointTypeToString(options.bottomType)
  dialog:AddDropDownList("BottomTypeSelect", bottomString)

  -- Grooved (slide-in) bottom options -- by Claude 9/18/2026
  dialog:AddDoubleField("BottomGrooveOffsetField", options.bottomGrooveOffset)
  dialog:AddDoubleField("BottomGrooveDepthField", options.bottomGrooveDepth)
  dialog:AddDoubleField("BottomGrooveWidthField", options.bottomGrooveWidth)

  -- "Bottom aus gleichem Material": cut the bottom panel from the same (full)
  -- material thickness as the walls, with a rabbet (Falz) milled along Side
  -- 1/Side 2/End 1's edges down to the groove width there.   -- by Claude 9/21/2026
  dialog:AddCheckBox("BottomSameMaterial", options.bottomSameMaterial)
  dialog:AddDoubleField("BottomGrooveClearanceField", options.bottomGrooveClearance)
  dialog:AddDoubleField("BottomRabbetCorrectionField", options.bottomRabbetDepthCorrection)

  -- "Side Overhang" (Side 1/Side 2 only, Lid Type None only).
  -- The user sets End 1's and End 2's own height directly and independently;
  -- Side 1/Side 2 stay the full box height, so each end's own overhang is just
  -- its own difference - no separate on/off switch is needed, both fields
  -- default to the box height (= no overhang) when equal to it.  -- by Claude 9/20/2026
  dialog:AddDoubleField("End1HeightField", options.end1Height)
  dialog:AddDoubleField("End2HeightField", options.end2Height)
  dialog:AddDoubleField("End1ChamferAngleField", options.end1ChamferAngle)
  dialog:AddDoubleField("End2ChamferAngleField", options.end2ChamferAngle)

  local units_string = "Inches"
  if options.tool.InMM then
    units_string = "MM"
  end

  dialog:AddTextField("UnitsLabel", units_string)

  local validator = function(dialog)
    -- Gremlin added bottomDoveTail seperation from side which is just sideDoveTail
    ReadOptionsFromDialog(dialog, options, sideDoveTail, bottomDoveTail, lidDoveTail)

    if not ValidateBoxDimensions(dialog, options, true) then
      return false
    end

    -- Grooved (slide-in) bottom: validate the groove offset/depth/width -- by Claude 9/18/2026
    if (options.bottomType == FaceJointType.Grooved) then
      if not IsNonNeg(options.bottomGrooveDepth) or options.bottomGrooveDepth <= 0 then
        DisplayMessageBox("Groove depth must be greater than 0.")
        return false
      end
      if options.bottomGrooveDepth >= options.thickness then
        DisplayMessageBox(string.format("Groove depth %.2f must be less than the material thickness %.2f.", options.bottomGrooveDepth, options.thickness))
        return false
      end
      if not IsNonNeg(options.bottomGrooveOffset) then
        DisplayMessageBox("Groove offset from the bottom edge (to the top of the groove) must be 0 or greater.")
        return false
      end
      if not IsNonNeg(options.bottomGrooveWidth) or options.bottomGrooveWidth <= 0 then
        DisplayMessageBox("Groove width must be greater than 0.")
        return false
      end
      -- Groove offset now measures up to the groove's TOP edge (was: bottom
      -- edge), so the groove itself (extending downward by groove width from
      -- there) must not reach below the wall's true bottom edge. -- by Claude 9/21/2026
      if options.bottomGrooveOffset < options.bottomGrooveWidth then
        DisplayMessageBox(string.format("Groove offset %.2f must be at least the groove width %.2f (the groove would otherwise reach below the wall's bottom edge).", options.bottomGrooveOffset, options.bottomGrooveWidth))
        return false
      end
      -- "Bottom aus gleichem Material": validate the clearance ("Luft") the
      -- panel's reach into each of the 3 grooves gets shortened by. The
      -- rabbet-depth correction isn't validated here - a bad value just
      -- yields a shallower/deeper (possibly zero) rabbet.   -- by Claude 9/21/2026
      if (options.bottomSameMaterial) then
        if not IsNonNeg(options.bottomGrooveClearance) then
          DisplayMessageBox("Bottom groove clearance (Luft) must be 0 or greater.")
          return false
        end
        if options.bottomGrooveClearance >= options.bottomGrooveDepth then
          DisplayMessageBox(string.format("Bottom groove clearance %.2f must be less than the groove depth %.2f.", options.bottomGrooveClearance, options.bottomGrooveDepth))
          return false
        end
      end
      -- End 2 is shortened to start at the top of the groove (bottomGrooveOffset
      -- itself, now that it measures up to the groove's top edge), so there must
      -- still be enough height left above that for End 2 itself (and for the
      -- lid's own reserved thickness, if any) to be a real panel. -- by Claude 9/21/2026
      local top_reserved = ThicknessForFaceType(options.lidType, options.thickness)
      if (options.bottomGrooveOffset + top_reserved) >= options.height then
        DisplayMessageBox(string.format("The groove offset is too large for the box height %.2f (End 2 would have no height left).", options.height))
        return false
      end
    end

    -- Tool must be chosen and valid (only when creating toolpaths)
    if not options.no_toolpath then
      if not Tool_ok(options.tool) then
        DisplayMessageBox("No tool selected or tool diameter is invalid.\n\nClick 'Select Tool' and pick a valid End Mill.")
        return false
      end
    end

    -- Roundover tool + cut depth are only required for box joints with no dogbones (mirrors HTML/JS visibility)
    local roundover_needed = (not options.no_toolpath) and (not options.dovetailJoint) and (not options.create_dogbones)
    if roundover_needed then
      if not Tool_ok(options.roundover_tool) then
        DisplayMessageBox("No roundover tool selected or tool diameter is invalid.\n\nClick 'Select Roundover Tool' and pick a valid tool.")
        return false
      end
      if not IsNonNeg(options.roundover_cut_depth) or options.roundover_cut_depth <= 0 then
        DisplayMessageBox("Roundover cut depth must be greater than 0.")
        return false
      end
      if options.roundover_cut_depth > (options.tool.ToolDia/2) then
        DisplayMessageBox("Make sure your roundover bit and depth are correct for your cutting tool.\nUsually the roundover cut depth should be less than or equal to half the diameter of the cutting tool.\n\nI have created the requested toolpaths but these could be wrong.")
      end
    end

    if not ValidateDovetailAngle(dialog, options, true) then
      return false
    end

    -- At least one face must be selected
    local at_least_one =
      options.facesToMake.lid or options.facesToMake.bottom or options.facesToMake.side1 or
      options.facesToMake.side2 or options.facesToMake.end1 or options.facesToMake.end2
    if not at_least_one then
      DisplayMessageBox("Select at least one face to create (Lid / Bottom / Sides / Ends).")
      return false
    end

    -- Edge margin must be non-negative
    if not IsNonNeg(options.clampingMargin) then
      DisplayMessageBox("Edge margin must be ≥ 0.")
      return false
    end

    if not ValidateJointWidths(dialog, options, sideDoveTail, bottomDoveTail, lidDoveTail, true) then
      return false
    end

    local double_thickness = options.thickness * 2
    local inner_width = options.width - double_thickness
    local inner_depth = options.depth - double_thickness

    -- "Side Overhang": End 1's and End 2's own heights
    -- (end1Height/end2Height) can each be set shorter than the box height,
    -- independently of one another; Side 1/Side 2 stay the full box height,
    -- so each end's own difference becomes its own overhang, tapered by a
    -- chamfer. Only valid without a lid, since a lid can't sit flush over the
    -- raised middle section of Side 1/Side 2.                    -- by Claude 9/20/2026
    local function ValidateEndHeight(end_height, chamfer_angle, end_label)
      if not IsNonNeg(end_height) or end_height <= 0 then
        DisplayMessageBox(string.format("The %s height must be greater than 0.", end_label))
        return false
      end
      if (end_height > options.height) then
        DisplayMessageBox(string.format("The %s height %.2f cannot be more than the box height %.2f.", end_label, end_height, options.height))
        return false
      end
      if (end_height < options.height) then
        if (options.lidType ~= FaceJointType.None) then
          DisplayMessageBox(string.format("A shorter %s height (\"Side Overhang\") only works with Lid Type = None (an open box), because a lid can't sit flush over the raised middle section of Side 1/Side 2.", end_label))
          return false
        end
        if end_height <= double_thickness then
          DisplayMessageBox(string.format("The %s height %.2f is too small for material thickness %.2f.", end_label, end_height, options.thickness))
          return false
        end
        -- Chamfer is now set as an angle (degrees, measured from vertical) rather
        -- than a width: 0 would be a plain vertical step (no taper) and 90 an
        -- infinitely long, perfectly flat ramp, so both ends are excluded.
        -- by Claude 9/20/2026
        if not IsNonNeg(chamfer_angle) or chamfer_angle <= 0 or chamfer_angle >= 90 then
          DisplayMessageBox(string.format("The %s chamfer angle must be greater than 0 and less than 90 degrees.", end_label))
          return false
        end
      end
      return true
    end
    if not ValidateEndHeight(options.end1Height, options.end1ChamferAngle, "End 1 (Front)") then return false end
    if not ValidateEndHeight(options.end2Height, options.end2ChamferAngle, "End 2 (Back)") then return false end

    -- Front and Back now each have their own chamfer angle, and the chamfer's
    -- horizontal run is derived from that angle and the actual overhang at each
    -- end (run = overhang * tan(angle)), exactly like MakeSideFace computes it -
    -- so the combined-width check has to derive both runs the same way rather
    -- than assuming a typed-in width.                                -- by Claude 9/20/2026
    if (options.lidType == FaceJointType.None) then
      local end1_overhang = math.max(0, options.height - options.end1Height)
      local end2_overhang = math.max(0, options.height - options.end2Height)
      if (end1_overhang > 0.0001 or end2_overhang > 0.0001) then
        local end1_chamfer_w = end1_overhang * math.tan(math.rad(options.end1ChamferAngle))
        local end2_chamfer_w = end2_overhang * math.tan(math.rad(options.end2ChamferAngle))
        if ((end1_chamfer_w + end2_chamfer_w) >= inner_width) then
          DisplayMessageBox(string.format("The overhang chamfers resulting from these angles (Front %.2f + Back %.2f) are too wide for the side's inner width %.2f - try steeper (smaller) chamfer angles.", end1_chamfer_w, end2_chamfer_w, inner_width))
          return false
        end
      end
    end

    return true
  end

  dialog:OnValidate(validator)
  local success = dialog:ShowDialog()

  if not success then
    ReadOptionsFromDialog(dialog, options, sideDoveTail, bottomDoveTail, lidDoveTail)
    SaveDefaultsToRegistry(options, true) -- the user hit cancel but save the window settings anyways
    return false
  end

  -- Gremlin added joint width seperation
  -- this is actually getting called twice, once here and once in the
  -- validator logic, is that correct?
  ReadOptionsFromDialog(dialog, options, sideDoveTail, bottomDoveTail, lidDoveTail)

  return true
end

-- Gremlin added joint width seperation for sides top and bottom
-- This function will read the options out of the dialog
function ReadOptionsFromDialog(dialog, options, sideDoveTail, bottomDoveTail, lidDoveTail)
  -- Read back data from the form
  options.width     = dialog:GetDoubleField("WidthField")
  options.depth     = dialog:GetDoubleField("DepthField")
  options.height    = dialog:GetDoubleField("HeightField")
  options.sideOrAllTabWidth  = dialog:GetDoubleField("SideTabWidthField")
  sideDoveTail.min_width = options.sideOrAllTabWidth
  -- Gremlin added joint width seperation for sides top and bottom
  options.useAllJointWidths = dialog:GetCheckBox("AllJointWidths")
  options.bottomTabWidth = dialog:GetDoubleField("BottomTabWidthField")
  options.lidTabWidth = dialog:GetDoubleField("TopTabWidthField")

  options.dark_mode     = dialog:GetCheckBox("DarkMode")
  options.label_faces   = dialog:GetCheckBox("LabelFaces")
  options.ZoomLevel = dialog:GetDropDownListValue("ZoomLevel")

  options.no_toolpath  = dialog:GetCheckBox("NoToolpath")
  options.create_dogbones  = dialog:GetCheckBox("CreateDogbones")
  options.useSingleSheet = dialog:GetCheckBox("UseSingleSheet")
  options.partLayout = dialog:GetDropDownListValue("PartLayoutSelect")
  options.facesToMake.lid      = dialog:GetCheckBox("MakeLid")
  options.facesToMake.bottom   = dialog:GetCheckBox("MakeBottom")
  options.bottomSameMaterial   = dialog:GetCheckBox("BottomSameMaterial")
  options.facesToMake.side1    = dialog:GetCheckBox("MakeSide1")
  options.facesToMake.side2    = dialog:GetCheckBox("MakeSide2")
  options.facesToMake.end1     = dialog:GetCheckBox("MakeEnd1")
  options.facesToMake.end2     = dialog:GetCheckBox("MakeEnd2")
  options.create_tabs_for_missing_faces = dialog:GetCheckBox("CreateTabsForMissingFaces")

  options.dovetailAngleDegrees = dialog:GetDoubleField("DovetailAngleField")
  sideDoveTail.angle = math.rad(options.dovetailAngleDegrees)
  bottomDoveTail.angle = math.rad(options.dovetailAngleDegrees)
  lidDoveTail.angle = math.rad(options.dovetailAngleDegrees)

  -- Set up the dovetail widths based on if we're using separate widths for each piece
  -- or not, use sidedovetail size for everything if not.
  if not options.useAllJointWidths then
    bottomDoveTail.min_width = sideDoveTail.min_width
    lidDoveTail.min_width = sideDoveTail.min_width
  else
    bottomDoveTail.min_width = options.bottomTabWidth
    lidDoveTail.min_width = options.lidTabWidth
  end

  sideDoveTail.max_width = sideDoveTail.min_width + (2 * options.thickness / math.tan(sideDoveTail.angle))
  bottomDoveTail.max_width = bottomDoveTail.min_width + (2* options.thickness/ math.tan(bottomDoveTail.angle))
  lidDoveTail.max_width = lidDoveTail.min_width + (2 * options.thickness / math.tan(lidDoveTail.angle))

  options.allowance   = dialog:GetDoubleField("AllowanceField")
  options.partSpacing = dialog:GetDoubleField("PartSpacingField")
  options.clampingMargin = dialog:GetDoubleField("ClampingMargin")
  if not options.clampingMargin or options.clampingMargin < 0 then
    options.clampingMargin = options.InMM and 15 or 0.5
  end


  local tab_index = dialog:GetRadioIndex("TabTypeRadio")
  if tab_index == 1 then
    options.dovetailJoint = false   -- Box joints
  else
    options.dovetailJoint = true    -- Dovetail joints
  end

  local lid_type = dialog:GetDropDownListValue("LidTypeSelect")
  options.lidType = FaceJointType[lid_type]
  if options.lidType == nil then
    -- Defensive fallback: an unrecognised dropdown value must never leave
    -- options.lidType nil, since that then poisons a Face's jointtype and
    -- crashes later as an obscure "table index is nil" error.  -- by Claude 9/18/2026
    options.lidType = FaceJointType.Inset
  end

  local bottom_type = dialog:GetDropDownListValue("BottomTypeSelect")
  options.bottomType = FaceJointType[bottom_type]
  if options.bottomType == nil then
    options.bottomType = FaceJointType.Fingers -- by Claude 9/18/2026
  end

  -- Grooved (slide-in) bottom options -- by Claude 9/18/2026
  options.bottomGrooveOffset = dialog:GetDoubleField("BottomGrooveOffsetField")
  options.bottomGrooveDepth = dialog:GetDoubleField("BottomGrooveDepthField")
  options.bottomGrooveWidth = dialog:GetDoubleField("BottomGrooveWidthField")
  options.bottomGrooveClearance = dialog:GetDoubleField("BottomGrooveClearanceField")
  options.bottomRabbetDepthCorrection = dialog:GetDoubleField("BottomRabbetCorrectionField")

  -- "Side Overhang": End 1's and End 2's own heights
  -- (independent of each other), plus the chamfer's horizontal run. If a
  -- field is empty/invalid, fall back to the box height (i.e. no overhang
  -- for that end) rather than leaving it nil.                    -- by Claude 9/20/2026
  options.end1Height = dialog:GetDoubleField("End1HeightField")
  if not options.end1Height or options.end1Height <= 0 then
    options.end1Height = options.height
  end
  options.end2Height = dialog:GetDoubleField("End2HeightField")
  if not options.end2Height or options.end2Height <= 0 then
    options.end2Height = options.height
  end
  options.end1ChamferAngle = dialog:GetDoubleField("End1ChamferAngleField")
  options.end2ChamferAngle = dialog:GetDoubleField("End2ChamferAngleField")


  -- Get from tool picker
  options.tool = dialog:GetTool("ToolChooseButton")

  -- Roundover tool + cut depth
  options.roundover_tool = dialog:GetTool("RoundoverToolChooseButton")
  options.roundover_cut_depth = dialog:GetDoubleField("RoundoverCutDepthField")

  ------------------------------------------------------------------
  -- NEW: clamp Joint Width (SideTabWidthField) to
  --      max(existing_width, calculated_min_for_tool)
  ------------------------------------------------------------------
  if Tool_ok(options.tool) then
    local mtl_block = MaterialBlock()
    local raw_dia   = ConvertUnitsFrom(options.tool.ToolDia or 0, options.tool, mtl_block)

    -- Apply Allowance the same way as in your validator
    local effective_dia = raw_dia
    if options.allowance and options.allowance > 0 then
      effective_dia = effective_dia - 2 * options.allowance
      if effective_dia < 0 then
        effective_dia = 0
      end
    end

    -- This is the "calculated minimum" joint width for this tool
    local calculated_min = effective_dia

    if calculated_min and calculated_min > 0 then
      local current_width = options.sideOrAllTabWidth or sideDoveTail.min_width
      local new_width     = math.max(current_width, calculated_min)

      if new_width ~= current_width then
        options.sideOrAllTabWidth   = new_width
        sideDoveTail.min_width = new_width

        -- Push it back into the dialog so user sees the update
        if dialog.SetDoubleField ~= nil then
          dialog:SetDoubleField("SideTabWidthField", new_width)
        end
      end
    end
  end
  ------------------------------------------------------------------

  options.window_width  = dialog.WindowWidth
  options.window_height = dialog.WindowHeight
end

--[[
--- Saves the passed in options table to the registry
---@param options table
---@param justwindowinfo boolean
]]

function SaveDefaultsToRegistry(options, justwindowinfo)
  local registry = Registry("BoxCreator_" .. G_version)

  -- UX defaults
  registry:SetDouble("WindowWidth", options.window_width)
  registry:SetDouble("WindowHeight", options.window_height)
  registry:SetBool("DarkMode", options.dark_mode)
  registry:SetBool("LabelFaces", options.label_faces)
  registry:SetString("ZoomLevel", options.ZoomLevel)

  if justwindowinfo then
    return
  end

  -- Box dimension settings
  registry:SetDouble("Width", options.width)
  registry:SetDouble("Height", options.height)
  registry:SetDouble("Depth", options.depth)
  registry:SetBool("InMM", options.InMM)
  registry:SetDouble("JointWidth", options.sideOrAllTabWidth)
  registry:SetDouble("BottomJointWidth", options.bottomTabWidth)     -- Added by Gremlin
  registry:SetDouble("TopJointWidth", options.lidTabWidth)         -- Added by Gremlin
  registry:SetBool("AllJointWidths", options.useAllJointWidths)           -- Added by Gremlin

  registry:SetDouble("Allowance", options.allowance)                 -- Added by Sharkcutup
  registry:SetDouble("PartsSpacing", options.partSpacing)
  registry:SetDouble("EdgeMargin", options.clampingMargin)              -- Added by Sharkcutup

  registry:SetBool("CutDovetails", options.dovetailJoint)
  registry:SetDouble("DovetailAngle", options.dovetailAngleDegrees)
  registry:SetDouble("LidType", options.lidType)
  registry:SetDouble("BottomType", options.bottomType)
  registry:SetDouble("BottomGrooveOffset", options.bottomGrooveOffset)  -- Added by Claude 9/18/2026
  registry:SetDouble("BottomGrooveDepth", options.bottomGrooveDepth)    -- Added by Claude 9/18/2026
  registry:SetDouble("BottomGrooveWidth", options.bottomGrooveWidth)    -- Added by Claude 9/18/2026
  registry:SetBool("BottomSameMaterial", options.bottomSameMaterial)                     -- Added by Claude 9/21/2026
  registry:SetDouble("BottomGrooveClearance", options.bottomGrooveClearance)             -- Added by Claude 9/21/2026
  registry:SetDouble("BottomRabbetDepthCorrection", options.bottomRabbetDepthCorrection) -- Added by Claude 9/21/2026
  registry:SetDouble("End1Height", options.end1Height)                             -- Added by Claude 9/20/2026
  registry:SetDouble("End2Height", options.end2Height)                             -- Added by Claude 9/20/2026
  registry:SetDouble("End1ChamferAngle", options.end1ChamferAngle)                 -- Added by Claude 9/20/2026
  registry:SetDouble("End2ChamferAngle", options.end2ChamferAngle)                 -- Added by Claude 9/20/2026

  if options.tool ~= nil then
    options.tool.ToolDBId:SaveDefaults("BoxCreator_"..G_version, "")
  end

  registry:SetBool("NoToolpath", options.no_toolpath)
  registry:SetBool("CreateDogbones", options.create_dogbones)
  registry:SetBool("SingleSheetBestEffort", options.useSingleSheet)
  registry:SetString("PartLayout", options.partLayout)

  registry:SetDouble("RoundoverCutDepth", options.roundover_cut_depth)
  if options.roundover_tool ~= nil then
    options.roundover_tool.ToolDBId:SaveDefaults("BoxCreator_"..G_version, "Roundover")
  end

  -- Machining settings
  registry:SetBool("MakeLid", options.facesToMake.lid)
  registry:SetBool("MakeBottom", options.facesToMake.bottom)
  registry:SetBool("MakeSide1", options.facesToMake.side1)
  registry:SetBool("MakeSide2", options.facesToMake.side2)
  registry:SetBool("MakeEnd1", options.facesToMake.end1)
  registry:SetBool("MakeEnd2", options.facesToMake.end2)
  registry:SetBool("CreateTabsForMissingFaces", options.create_tabs_for_missing_faces)

end

-- Gremlin added bottomDoveTail separation from side which is just dovetail
function LoadDefaultsFromRegistry(options, sideDoveTail, bottomDoveTail, lidDoveTail)
  local registry =  Registry("BoxCreator_" .. G_version)

  options.window_width = registry:GetDouble("WindowWidth", options.window_width)
  options.window_height = registry:GetDouble("WindowHeight", options.window_height)

  options.width = registry:GetDouble("Width", options.width)
  options.height = registry:GetDouble("Height", options.height)
  options.depth = registry:GetDouble("Depth", options.depth)
  options.InMM = registry:GetBool("InMM", options.InMM)
  options.sideOrAllTabWidth = registry:GetDouble("JointWidth", options.sideOrAllTabWidth)
  options.bottomTabWidth = registry:GetDouble("BottomJointWidth", options.sideOrAllTabWidth)  --Added by Gremlin
  options.lidTabWidth = registry:GetDouble("TopJointWidth", options.sideOrAllTabWidth)      --Added by Gremlin
  options.useAllJointWidths = registry:GetBool("AllJointWidths", options.useAllJointWidths)  -- Added by Gremlin

  options.allowance = registry:GetDouble("Allowance", options.allowance)           -- Added by Sharkcutup
  options.partSpacing = registry:GetDouble("PartsSpacing", options.partSpacing)
  options.clampingMargin = registry:GetDouble("EdgeMargin", options.clampingMargin)      -- Added by Sherkcutup

  -- sideDoveTail.min_width = options.sideOrAllTabWidth
  -- bottomDoveTail.min_width = options.bottomTabWidth -- Added by Gremlin
  -- lidDoveTail.min_width = options.lidTabWidth -- Added by Gremlin
  options.dovetailJoint = registry:GetBool("CutDovetails", options.dovetailJoint)
  options.dovetailAngleDegrees = registry:GetDouble("DovetailAngle", options.dovetailAngleDegrees)
  options.lidType = registry:GetDouble("LidType", options.lidType)
  options.bottomType = registry:GetDouble("BottomType", options.bottomType)
  options.bottomGrooveOffset = registry:GetDouble("BottomGrooveOffset", options.bottomGrooveOffset)  -- Added by Claude 9/18/2026
  options.bottomGrooveDepth = registry:GetDouble("BottomGrooveDepth", options.bottomGrooveDepth)      -- Added by Claude 9/18/2026
  options.bottomGrooveWidth = registry:GetDouble("BottomGrooveWidth", options.bottomGrooveWidth)      -- Added by Claude 9/18/2026
  options.bottomSameMaterial = registry:GetBool("BottomSameMaterial", options.bottomSameMaterial)                         -- Added by Claude 9/21/2026
  options.bottomGrooveClearance = registry:GetDouble("BottomGrooveClearance", options.bottomGrooveClearance)              -- Added by Claude 9/21/2026
  options.bottomRabbetDepthCorrection = registry:GetDouble("BottomRabbetDepthCorrection", options.bottomRabbetDepthCorrection) -- Added by Claude 9/21/2026
  -- Fall back to the just-loaded options.height (not the pre-load default) so a
  -- registry with no saved End1Height/End2Height yet (e.g. right after
  -- upgrading) comes up as "no overhang" instead of accidentally showing a
  -- stale one.                                                    -- by Claude 9/20/2026
  options.end1Height = registry:GetDouble("End1Height", options.height)
  options.end2Height = registry:GetDouble("End2Height", options.height)
  options.end1ChamferAngle = registry:GetDouble("End1ChamferAngle", options.end1ChamferAngle) -- Added by Claude 9/20/2026
  options.end2ChamferAngle = registry:GetDouble("End2ChamferAngle", options.end2ChamferAngle) -- Added by Claude 9/20/2026
  options.default_toolid = ToolDBId("BoxCreator_"..G_version, "")

  options.roundover_cut_depth = registry:GetDouble("RoundoverCutDepth", options.roundover_cut_depth)
  options.roundover_default_toolid = ToolDBId("BoxCreator_"..G_version, "Roundover")

  options.dark_mode     = registry:GetBool("DarkMode", true)     -- default ON
  options.label_faces   = registry:GetBool("LabelFaces", true)    -- default ON
  options.ZoomLevel = registry:GetString("ZoomLevel", options.ZoomLevel) -- default Auto
  options.no_toolpath = registry:GetBool("NoToolpath", options.no_toolpath)
  options.create_dogbones = registry:GetBool("CreateDogbones", options.create_dogbones)
  options.useSingleSheet = registry:GetBool("SingleSheetBestEffort", options.useSingleSheet)
  options.partLayout = registry:GetString("PartLayout", options.partLayout)

  options.facesToMake.lid = registry:GetBool("MakeLid", options.facesToMake.lid)
  options.facesToMake.bottom = registry:GetBool("MakeBottom", options.facesToMake.bottom)
  options.facesToMake.side1 = registry:GetBool("MakeSide1", options.facesToMake.side1)
  options.facesToMake.side2 = registry:GetBool("MakeSide2", options.facesToMake.side2)
  options.facesToMake.end1 = registry:GetBool("MakeEnd1", options.facesToMake.end1)
  options.facesToMake.end2 = registry:GetBool("MakeEnd2", options.facesToMake.end2)
  options.create_tabs_for_missing_faces = registry:GetBool("CreateTabsForMissingFaces", options.create_tabs_for_missing_faces)

end

--- By putting this function in the script we don't need to create
--- individual functions unless we need specific handling
function OnLuaButton_XXXX()
  return true
end

function OnLuaButton_DimensionsChanged(dialog)
  -- Whenever any of the box dimensions, joint widths, dovetail angle or
  -- allowance changes, this function is called via a script in the html
  -- toggling the hidden checkbox associated with it. Read everything back
  -- from the dialog - not just the field that was actually edited - so the
  -- validation below always sees the full current picture (a joint width
  -- change needs box dimensions, a dimension change needs joint widths,
  -- etc.), then run the same checks the OK button uses, but silently
  -- (report_as_dialog = false) so each bad field gets its own Invalid
  -- checkbox flagged instead of a blocking message box.
  if not G_dialogOptions then
    return true
  end

  ReadOptionsFromDialog(dialog, G_dialogOptions, G_dialogSideDoveTail, G_dialogBottomDoveTail, G_dialogLidDoveTail)

  ValidateBoxDimensions(dialog, G_dialogOptions, false)
  ValidateDovetailAngle(dialog, G_dialogOptions, false)
  ValidateJointWidths(dialog, G_dialogOptions, G_dialogSideDoveTail, G_dialogBottomDoveTail, G_dialogLidDoveTail, false)

  return true
end