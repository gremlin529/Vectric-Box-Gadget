name: Auto-translate issues and comments

# Non-English text  -> English translation
# English text      -> German translation

on:
  issues:
    types: [opened]
  issue_comment:
    types: [created]
  pull_request_target:
    types: [opened]
  pull_request_review_comment:
    types: [created]
  pull_request_review:
    types: [submitted]

permissions:
  issues: write
  pull-requests: write

jobs:
  translate:
    runs-on: ubuntu-latest
    steps:
      - name: Translate
        uses: actions/github-script@v7
        env:
          DEEPL_API_KEY: ${{ secrets.DEEPL_API_KEY }}
        with:
          script: |
            const MARKER = '<!-- auto-translation -->';
            const p = context.payload;

            // Pull body, author and issue/PR number out of whichever event fired
            let body, user, number;
            switch (context.eventName) {
              case 'issues':
                body = p.issue.body; user = p.issue.user; number = p.issue.number; break;
              case 'issue_comment':
                body = p.comment.body; user = p.comment.user; number = p.issue.number; break;
              case 'pull_request_target':
                body = p.pull_request.body; user = p.pull_request.user; number = p.pull_request.number; break;
              case 'pull_request_review_comment':
                body = p.comment.body; user = p.comment.user; number = p.pull_request.number; break;
              case 'pull_request_review':
                body = p.review.body; user = p.review.user; number = p.pull_request.number; break;
              default:
                return;
            }

            // Don't translate bots or our own translations (prevents loops)
            if (!body || user.type === 'Bot' || body.includes(MARKER)) return;

            // Protect fenced code blocks from translation
            const blocks = [];
            const prepared = body.replace(/```[\s\S]*?```/g, (m) => {
              blocks.push(m);
              return `CODEBLOCK${blocks.length - 1}X`;
            });
            if (!prepared.replace(/CODEBLOCK\d+X/g, '').trim()) return;

            const key = process.env.DEEPL_API_KEY;
            const host = key.endsWith(':fx') ? 'api-free.deepl.com' : 'api.deepl.com';

            async function deepl(text, target) {
              const res = await fetch(`https://${host}/v2/translate`, {
                method: 'POST',
                headers: {
                  'Authorization': `DeepL-Auth-Key ${key}`,
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify({ text: [text], target_lang: target }),
              });
              if (!res.ok) throw new Error(`DeepL error ${res.status}: ${await res.text()}`);
              const t = (await res.json()).translations[0];
              return {
                detected: t.detected_source_language,
                text: t.text.replace(/CODEBLOCK(\d+)X/g, (_, i) => blocks[i] ?? ''),
              };
            }

            // Step 1: translate to English and see what language it was
            const en = await deepl(prepared, 'EN-US');

            let label, translated;
            if (en.detected !== 'EN') {
              label = `English (translated from ${en.detected})`;
              translated = en.text;
            } else {
              // Step 2: it was already English, so translate to German
              const de = await deepl(prepared, 'DE');
              label = 'Deutsch (automatisch übersetzt)';
              translated = de.text;
            }

            await github.rest.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: number,
              body: `> 🌐 **Automatic translation: ${label}**\n\n${translated}\n\n${MARKER}`,
            });